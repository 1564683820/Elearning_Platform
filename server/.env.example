# ===== 应用 =====
APP_NAME=E-Learning API
APP_VERSION=0.1.0
DEBUG=true
SECRET_KEY=

# ===== 数据库 =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=elearningtest
MYSQL_USER=root
MYSQL_PASSWORD=

# ===== Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
