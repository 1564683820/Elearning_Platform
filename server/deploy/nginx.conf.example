# ============================================================
# E-Learning Nginx 配置模板
# 适用: 宝塔面板 / 原生 Nginx
# 使用方式:
#   宝塔: 复制此配置到网站 → 设置 → 配置文件中
#   原生: 复制到 /etc/nginx/sites-enabled/elearning.conf
#         或 /etc/nginx/conf.d/elearning.conf
# ============================================================

# ── HTTP → HTTPS 重定向 ──
server {
    listen 80;
    server_name yourdomain.com;                    # ← 修改为你的域名
    return 301 https://$host$request_uri;
}

# ── HTTPS 服务器 ──
server {
    listen 443 ssl http2;
    server_name yourdomain.com;                    # ← 修改为你的域名

    # ── SSL 证书 ──
    # 宝塔面板: 网站 → SSL → 申请 Let's Encrypt 证书（自动配置）
    # 路径通常为: /www/server/panel/vhost/cert/yourdomain.com/fullchain.pem
    ssl_certificate     /www/server/panel/vhost/cert/yourdomain.com/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/yourdomain.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # ── 上传大小 & 超时（试卷图片/视频合成等大文件） ──
    client_max_body_size 500M;
    proxy_connect_timeout 600s;
    proxy_send_timeout 600s;
    proxy_read_timeout 600s;

    # ── 日志 ──
    access_log /www/wwwroot/elearning/logs/nginx_access.log;
    error_log  /www/wwwroot/elearning/logs/nginx_error.log;

    # ── 主路由：全部转发到后端 FastAPI ──
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket / SSE 支持（AI 流式对话需要）
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # 关闭缓冲，确保 SSE 即时推送
        proxy_buffering off;
        proxy_cache off;
    }

    # ── H5 入口和静态文件，缓存策略由应用区分 ──
    location ^~ /h5/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ── 其他静态资源缓存优化 ──
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|woff2?|ttf|svg|eot|mp3|mp4|webm)$ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;  # 静态资源不记日志
    }

    # ── 安全头 ──
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
}
