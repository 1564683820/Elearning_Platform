/* 角色选择页 */

/* 页面容器 — 自定义导航栏时无默认padding */
.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 0 40rpx;
  box-sizing: border-box;
  background: var(--bg);
}

/* 顶部装饰区 */
.hero-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0 48rpx;
}

.hero-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.hero-desc {
  font-size: 26rpx;
  color: var(--text-muted);
}

/* 角色列表 */
.role-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 角色卡片 */
.role-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx;
  position: relative;
  border: 3rpx solid transparent;
  transition: all 0.2s ease;
}

.role-card.selected {
  border-color: var(--primary);
  background: var(--primary-bg);
  box-shadow: 0 4rpx 20rpx rgba(91,158,111,0.15);
}

/* 角色头像 */
.role-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.student-avatar {
  background: #EEF2FF;
}

.teacher-avatar {
  background: #FFF7ED;
}

.personal-avatar {
  background: #F0FDF4;
}

/* 角色信息 */
.role-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.role-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.role-desc {
  font-size: 24rpx;
  color: var(--text-muted);
  line-height: 1.5;
}

/* 选中标记 */
.role-check {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.check-icon {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 700;
}

/* 确认按钮 */
.confirm-btn {
  margin: 48rpx 0 24rpx;
}

.confirm-btn.disabled {
  opacity: 0.4;
  pointer-events: none;
}

/* 跳过入口 */
.skip-area {
  text-align: center;
  padding: 24rpx 0 48rpx;
}

.skip-text {
  font-size: 26rpx;
  color: var(--text-light);
  text-decoration: underline;
}