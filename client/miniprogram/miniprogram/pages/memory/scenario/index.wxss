/* 情景记忆 */

/* 页面头部 - header-bar样式 */
.header-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 40rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid var(--border);
}

.header-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: var(--border-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.header-btn-icon {
  font-size: 32rpx;
  color: var(--text-primary);
}

.header-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.header-spacer {
  width: 72rpx;
}

/* 内容区 */
.content-area {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  padding: 28rpx 0;
}

/* 选项卡片 */
.option-card {
  padding: 32rpx;
}

.option-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.option-icon {
  font-size: 28rpx;
  color: var(--primary);
}

.option-icon-light {
  font-size: 28rpx;
  color: var(--primary-light);
}

.option-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #374151;
}

.option-row {
  display: flex;
  gap: 16rpx;
}

/* 错题单词预览 */
.preview-card {
  padding: 28rpx 32rpx;
}

.preview-hint {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 20rpx;
  display: block;
}

.word-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.word-tag {
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  background: #EEF2FF;
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 500;
}

/* 生成按钮 */
.generate-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(91,158,111,0.4);
}

.btn-icon {
  font-size: 28rpx;
}

/* 生成结果 */
.result-card {
  box-shadow: var(--shadow-md);
}

.result-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.result-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.result-icon {
  font-size: 28rpx;
}

.result-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--success);
}

.bookmark-btn {
  font-size: 32rpx;
  color: var(--text-muted);
  padding: 4rpx;
}

.result-content {
  margin-bottom: 20rpx;
}

.result-text {
  font-size: 28rpx;
  color: #374151;
  line-height: 1.8;
}

.video-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  border-radius: 24rpx;
  background: #F3F4F6;
  color: #374151;
  font-size: 28rpx;
  font-weight: 500;
}
