<!-- 情景记忆视频播放页 -->
<view class="page">
  <!-- 视频播放器 -->
  <view class="video-wrapper" wx:if="{{videoUrl}}">
    <video class="video-player" src="{{videoUrl}}" controls autoplay="{{false}}"
           object-fit="contain" show-center-play-btn="{{true}}"
           bindplay="onPlay" bindpause="onPause" binderror="onVideoError">
    </video>
  </view>
  <view class="video-placeholder" wx:else>
    <text class="placeholder-icon">🎬</text>
    <text class="placeholder-text" wx:if="{{loading}}">正在加载视频...</text>
    <text class="placeholder-text" wx:else>暂无视频</text>
  </view>

  <scroll-view scroll-y class="content-scroll">
    <!-- 关联情景文段 -->
    <view class="card section-card" wx:if="{{passage}}">
      <view class="section-header">
        <text class="section-icon"></text>
        <text class="section-title">情景文段</text>
      </view>
      <view class="passage-content">
        <text user-select class="passage-text">{{passage}}</text>
      </view>
    </view>

    <!-- 关联单词列表 -->
    <view class="card section-card">
      <view class="section-header">
        <text class="section-icon"></text>
        <text class="section-title">本视频关联单词（{{words.length}}个）</text>
      </view>
      <view class="word-list">
        <view class="word-item" wx:for="{{words}}" wx:key="id"
              data-word="{{item.word}}" bindtap="onWordTap">
          <view class="word-main">
            <text class="word-text">{{item.word}}</text>
            <text class="word-phonetic">{{item.phonetic || ''}}</text>
          </view>
          <text class="word-meaning">{{item.meaning || ''}}</text>
        </view>
      </view>
    </view>

    <!-- 视频信息 -->
    <view class="card section-card">
      <view class="section-header">
        <text class="section-icon">ℹ️</text>
        <text class="section-title">视频信息</text>
      </view>
      <view class="info-row">
        <text class="info-label">创建时间</text>
        <text class="info-value">{{createdAt || '未知'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">状态</text>
        <text class="info-value tag-status {{status}}">{{statusText}}</text>
      </view>
      <view class="info-row" wx:if="{{duration}}">
        <text class="info-label">时长</text>
        <text class="info-value">{{duration}}</text>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-bar">
      <view class="btn-primary action-btn" bindtap="onBookmark">
        <text>{{isBookmarked ? '' : ''}}</text>
        <text>{{isBookmarked ? '已收藏' : '收藏视频'}}</text>
      </view>
    </view>
  </scroll-view>
</view>