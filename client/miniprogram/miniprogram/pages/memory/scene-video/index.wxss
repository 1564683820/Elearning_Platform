/* 情景记忆视频播放页 */

/* 视频播放器 */
.video-wrapper {
  width: 100%;
  background: #000000;
}

.video-player {
  width: 100%;
  height: 420rpx;
}

/* 视频占位 */
.video-placeholder {
  width: 100%;
  height: 420rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #1a1a2e;
}

.placeholder-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.placeholder-text {
  font-size: 26rpx;
  color: rgba(255,255,255,0.6);
}

/* 内容滚动区 */
.content-scroll {
  flex: 1;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
}

/* 章节卡片 */
.section-card {
  padding: 32rpx;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.section-icon {
  font-size: 28rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

/* 文段内容 */
.passage-content {
  padding: 24rpx;
  background: var(--border-light);
  border-radius: var(--radius-md);
}

.passage-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.8;
}

/* 单词列表 */
.word-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.word-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-radius: var(--radius-md);
  background: var(--border-light);
}

.word-main {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.word-text {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.word-phonetic {
  font-size: 22rpx;
  color: var(--text-muted);
}

.word-meaning {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 信息行 */
.info-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-lighter);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: var(--text-muted);
}

.info-value {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
}

/* 状态标签 */
.tag-status {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.tag-status.completed {
  background: var(--success-bg);
  color: var(--success);
}

.tag-status.processing {
  background: var(--warning-bg);
  color: var(--warning);
}

.tag-status.failed {
  background: var(--danger-bg);
  color: var(--danger);
}

/* 操作按钮 */
.action-bar {
  padding: 32rpx 0 48rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}