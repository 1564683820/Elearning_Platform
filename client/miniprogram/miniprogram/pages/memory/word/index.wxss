  animation: dotPulse 1.2s infinite;
}
.oescene-dot:nth-child(2) { animation-delay: 0.2s; }
.oescene-dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes dotPulse {
  0%, 80%, 100% { opacity: 0.3; transform: scale(0.8); }
  40% { opacity: 1; transform: scale(1); }
}

