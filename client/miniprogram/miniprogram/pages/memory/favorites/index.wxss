/* 收藏 */

/* 页面头部 - header-bar样式 */
.header-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 40rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid var(--border);
}

.header-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: var(--border-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.header-btn-icon {
  font-size: 28rpx;
  color: var(--text-primary);
}

.header-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

/* Tab切换 - 底部下划线样式 */
.tabs-row {
  display: flex;
  background: #FFFFFF;
  border-bottom: 1rpx solid var(--border);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 26rpx;
  color: var(--text-muted);
  font-weight: 400;
  position: relative;
  transition: all 0.2s;
  border-bottom: 4rpx solid transparent;
}

.tab-item.active {
  font-weight: 700;
  color: var(--primary);
  border-bottom-color: var(--primary);
}

/* 收藏列表 */
.fav-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 24rpx 32rpx 120rpx;
  box-sizing: border-box;
}

.fav-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  box-shadow: var(--shadow-sm);
  box-sizing: border-box;
  transition: background 0.2s;
}

.fav-item.edit-mode {
  padding-left: 16rpx;
}

.fav-word {
  font-size: 30rpx;
  font-weight: 500;
  color: #374151;
}

.fav-item-right {
  display: flex;
  align-items: center;
  padding-left: 16rpx;
  flex-shrink: 0;
}

.fav-remove {
  font-size: 36rpx;
  color: var(--danger, #ef4444);
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fav-item-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}

.fav-item.edit-mode .fav-item-left {
  padding-left: 12rpx;
}

.fav-meaning {
  font-size: 24rpx;
  color: var(--text-muted);
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ===== 编辑模式 - 复选框 ===== */
.fav-checkbox {
  flex-shrink: 0;
  padding: 8rpx;
}

.checkbox-box {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #d1d5db;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.checkbox-box.checked {
  background: var(--primary, #6366f1);
  border-color: var(--primary, #6366f1);
}

.checkbox-icon {
  font-size: 22rpx;
  color: #ffffff;
  font-weight: 700;
}

/* ===== 编辑模式 - 底部操作栏 ===== */
.edit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-top: 1rpx solid var(--border);
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  transform: translateY(100%);
  transition: transform 0.3s;
  z-index: 100;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.08);
}

.edit-bar.show {
  transform: translateY(0);
}

.edit-bar-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 0;
}

.edit-bar-label {
  font-size: 26rpx;
  color: var(--text-primary);
}

.edit-bar-right {
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  background: #f3f4f6;
  transition: all 0.2s;
}

.edit-bar-right.active {
  background: var(--danger, #ef4444);
}

.edit-bar-delete {
  font-size: 26rpx;
  color: #6b7280;
  font-weight: 500;
}

.edit-bar-right.active .edit-bar-delete {
  color: #ffffff;
}

/* ===== 文段详情弹窗 ===== */
.modal-overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}

.modal-overlay.show {
  opacity: 1;
  pointer-events: auto;
}

.modal-content {
  width: 92%;
  max-height: 80vh;
  background: #ffffff;
  border-radius: 32rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.15);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 36rpx;
  border-bottom: 1rpx solid var(--border);
  flex-shrink: 0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.modal-close {
  font-size: 40rpx;
  color: var(--text-muted);
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: background 0.2s;
}
.modal-close:active {
  background: var(--border-light);
}

.modal-body {
  padding: 32rpx 36rpx;
  overflow-y: auto;
  line-height: 1.8;
}

.modal-passage-type {
  font-size: 22rpx;
  color: var(--primary);
  margin-bottom: 20rpx;
  padding: 6rpx 18rpx;
  background: #eef2ff;
  border-radius: 20rpx;
  display: inline-block;
  font-weight: 500;
}

.modal-passage-text {
  font-size: 30rpx;
  color: #374151;
  line-height: 2;
  white-space: pre-wrap;
  word-break: break-word;
}

.passage-bold {
  font-weight: 700;
  color: var(--primary);
}

.modal-passage-trans {
  margin-top: 28rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border);
}

.trans-label {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-bottom: 12rpx;
}

.trans-text {
  font-size: 28rpx;
  color: #6B7280;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-word;
}

/* 加载中 */
.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-muted);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  gap: 16rpx;
}

.empty-icon {
  font-size: 64rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-muted);
}
