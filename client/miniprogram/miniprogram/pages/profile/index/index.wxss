/* 我的 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
}

/* 渐变Header */
.profile-header {
  background: linear-gradient(135deg, #5B9E6F 0%, #7AB88A 100%);
  padding: 80rpx 40rpx 40rpx;
  color: #FFFFFF;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-bottom: 40rpx;
}

.avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 32rpx;
  background: rgba(255,255,255,0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  border: 4rpx solid rgba(255,255,255,0.4);
}

.avatar-camera {
  position: absolute;
  right: -8rpx;
  bottom: -8rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.2);
}

.user-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.user-email {
  font-size: 24rpx;
  color: rgba(255,255,255,0.75);
  margin-top: 4rpx;
}

.user-tags {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.user-tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 99rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.tag-phase {
  background: rgba(255,255,255,0.2);
}

.tag-days {
  background: rgba(255,255,255,0.15);
  color: rgba(255,255,255,0.8);
}

/* 数据统计 - 三个独立圆角块 */
.user-stats {
  display: flex;
  gap: 16rpx;
}

.stat-box {
  flex: 1;
  border-radius: 32rpx;
  padding: 20rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255,255,255,0.15);
}

.stat-value {
  font-size: 34rpx;
  font-weight: 800;
}

.stat-label {
  font-size: 20rpx;
  color: rgba(255,255,255,0.7);
  margin-top: 4rpx;
}

/* 菜单 */
.menu-scroll {
  flex: 1;
}

/* 列表组 - 匹配UI原型 */
.list-group {
  margin-bottom: 24rpx;
  overflow: hidden;
}

/* menu-scroll内部内容统一padding */
.scroll-content {
  padding: 24rpx 32rpx;
  box-sizing: border-box;
}

.list-group-title {
  padding: 20rpx 32rpx 4rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--border-lighter);
}

.list-item:last-child {
  border-bottom: none;
}

.list-item-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

/* 统一icon-box样式 */
.icon-box {
  width: 56rpx;
  height: 56rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.icon-box.primary {
  background: var(--primary-bg);
}

.icon-emoji {
  font-size: 26rpx;
}

.list-item-label {
  font-size: 28rpx;
  color: var(--text-primary);
}

.list-item-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.list-item-value {
  font-size: 24rpx;
  color: var(--text-muted);
}

.list-item-arrow {
  font-size: 28rpx;
  color: var(--text-light);
}



/* 退出登录 */
.logout-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 28rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-sm);
}

.logout-icon {
  font-size: 28rpx;
}

.logout-text {
  font-size: 28rpx;
  color: var(--danger);
  font-weight: 600;
}

/* 版本信息 */
.version-footer {
  padding: 24rpx 0 48rpx;
  text-align: center;
}

.version-text {
  font-size: 22rpx;
  color: var(--text-light);
}

/* ===== 角色化头部渐变色 ===== */
.profile-student {
  background: linear-gradient(135deg, #5B9E6F 0%, #7AB88A 100%);
}

.profile-teacher {
  background: linear-gradient(135deg, #F59E0B 0%, #FBBF24 100%);
}

.profile-personal {
  background: linear-gradient(135deg, #6366F1 0%, #818CF8 100%);
}

.profile-admin {
  background: linear-gradient(135deg, #EF4444 0%, #F87171 100%);
}

/* ===== 头像图片 ===== */
.avatar-img {
  width: 128rpx;
  height: 128rpx;
  border-radius: 32rpx;
  border: 4rpx solid rgba(255,255,255,0.4);
}

.avatar-hidden {
  display: none;
}

/* ===== 角色标签 ===== */
.user-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.role-badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 99rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.role-student {
  background: rgba(91, 158, 111, 0.2);
  color: #5B9E6F;
}

.role-teacher {
  background: rgba(245, 158, 11, 0.2);
  color: #D97706;
}

.role-personal {
  background: rgba(99, 102, 241, 0.2);
  color: #6366F1;
}

.role-admin {
  background: rgba(239, 68, 68, 0.2);
  color: #DC2626;
}

/* ===== 会员标签 ===== */
.tag-membership {
  background: linear-gradient(135deg, #F59E0B 0%, #F97316 100%);
  color: #FFFFFF;
}

/* ===== 卡片容器 ===== */
.card {
  background: #FFFFFF;
  border-radius: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

/* ===== 列表副标题 ===== */
.list-item-sub {
  font-size: 22rpx;
  color: var(--text-light);
  margin-top: 4rpx;
}
