<view class="page">
  <!-- 顶部栏 -->
  <view class="nav-bar" style="padding-top: {{navBarTop}}px;">
    <view class="nav-inner" style="height: {{navBarHeight}}px;">
      <view class="nav-back" bindtap="onBack">
        <text class="nav-arrow">‹</text>
      </view>
      <text class="nav-title">编辑资料</text>
      <view class="nav-placeholder"></view>
    </view>
  </view>

  <!-- 可滚动内容区 -->
  <scroll-view scroll-y class="scroll-area" enable-back-to-top>
    <view class="scroll-inner">

      <!-- 头像 -->
      <view class="avatar-block">
        <view class="avatar-frame" bindtap="onChangeAvatar">
          <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
          <text wx:else class="avatar-placeholder">{{initials}}</text>
          <view class="avatar-badge">
            <text class="badge-icon">+</text>
          </view>
        </view>
        <text class="avatar-hint">点按更换头像</text>
      </view>

      <!-- 表单卡片 -->
      <view class="form-card">
        <!-- 昵称 -->
        <view class="field">
          <text class="field-label">昵称</text>
          <input class="field-input" placeholder="你的称呼" value="{{name}}"
                 bindinput="onNameInput" maxlength="20" confirm-type="done" />
        </view>

        <!-- 邮箱 -->
        <view class="field">
          <text class="field-label">邮箱</text>
          <input class="field-input" placeholder="选填，用于找回密码" value="{{email}}"
                 bindinput="onEmailInput" type="text" maxlength="50" />
        </view>

        <!-- 学习阶段 -->
        <view class="field field-last">
          <text class="field-label">学习阶段</text>
          <picker mode="selector" range="{{studyPhases}}" value="{{phaseIndex}}"
                  bindchange="onPhaseChange">
            <view class="field-picker">
              <text class="picker-text">{{studyPhases[phaseIndex]}}</text>
              <text class="picker-arrow">›</text>
            </view>
          </picker>
        </view>
      </view>

      <!-- 底部提示 -->
      <view class="bottom-note">
        <text class="note-text">修改后的信息将同步到你的学习数据中</text>
      </view>

      <!-- 保存按钮 -->
      <view class="save-button {{saving ? 'disabled' : ''}}" bindtap="onSave">
        <text wx:if="{{!saving}}">保存</text>
        <text wx:else>保存中</text>
      </view>

    </view>
  </scroll-view>
</view>
