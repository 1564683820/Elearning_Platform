/* 系统状态 — 后端服务连接状态 */
.page {
  min-height: 100vh;
  background: #F5F7FA;
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx;
  color: #9CA3AF;
  font-size: 28rpx;
}

.content {
  height: 100vh;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
}

/* ===== 整体状态横幅 ===== */
.banner {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 32rpx;
  border-radius: 24rpx;
  margin-bottom: 32rpx;
}
.banner-ok { background: linear-gradient(135deg, #D1FAE5, #A7F3D0); }
.banner-degraded { background: linear-gradient(135deg, #FEF3C7, #FDE68A); }
.banner-warning { background: linear-gradient(135deg, #FEF3C7, #FBBF24); }
.banner-error { background: linear-gradient(135deg, #FEE2E2, #FCA5A5); }

.banner-icon { font-size: 48rpx; }
.banner-text { flex: 1; }
.banner-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2937;
  display: block;
}
.banner-sub {
  font-size: 22rpx;
  color: #6B7280;
  margin-top: 6rpx;
  display: block;
}

/* ===== 分区标题 ===== */
.section { margin-bottom: 32rpx; }
.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0 16rpx;
}
.section-icon { font-size: 32rpx; }
.section-label {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2937;
}

/* ===== 服务卡片 ===== */
.service-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

/* 服务头部行（可点击展开/折叠） */
.service-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  cursor: pointer;
}
.service-header:active {
  background: #F9FAFB;
}

.service-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.service-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 状态圆点 */
.service-status-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.service-status-dot.ok { background: #5B9E6F; box-shadow: 0 0 8rpx rgba(91,158,111,0.4); }
.service-status-dot.degraded { background: #F59E0B; box-shadow: 0 0 8rpx rgba(245,158,11,0.4); }
.service-status-dot.warning { background: #F97316; box-shadow: 0 0 8rpx rgba(249,115,22,0.4); }
.service-status-dot.error { background: #EF4444; box-shadow: 0 0 8rpx rgba(239,68,68,0.4); }

.service-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
}

.service-status-text {
  font-size: 24rpx;
  font-weight: 600;
}
.service-status-text.ok { color: #5B9E6F; }
.service-status-text.degraded { color: #F59E0B; }
.service-status-text.warning { color: #F97316; }
.service-status-text.error { color: #EF4444; }

.toggle-arrow {
  font-size: 20rpx;
  color: #9CA3AF;
  transition: transform 0.2s;
}
.toggle-arrow.expanded {
  transform: rotate(90deg);
}

/* ===== 详情面板（可折叠） ===== */
.service-detail {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
  background: #FAFBFC;
}
.service-detail.show {
  max-height: 1000rpx;
}

.detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 32rpx;
  border-top: 1rpx solid #F3F4F6;
}

.detail-key {
  font-size: 24rpx;
  color: #6B7280;
  flex-shrink: 0;
}

.detail-val {
  font-size: 24rpx;
  color: #374151;
  font-weight: 500;
  text-align: right;
  max-width: 60%;
  word-break: break-all;
}
.detail-val.monospace {
  font-family: 'Courier New', monospace;
  font-size: 22rpx;
  color: #5B9E6F;
}
.detail-val.green { color: #5B9E6F; }
.detail-val.yellow { color: #F59E0B; }
.detail-val.red { color: #EF4444; }

/* 额外信息框 */
.extras-box {
  border-top: 1rpx dashed #E5E7EB;
  margin: 0 32rpx;
  padding: 8rpx 0;
}

/* ===== 操作按钮 ===== */
.action-row {
  margin-top: 8rpx;
}
.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 28rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.action-btn:active {
  background: #F9FAFB;
}
.action-icon { font-size: 28rpx; }
.action-label {
  font-size: 26rpx;
  color: #6B7280;
  font-weight: 500;
}
