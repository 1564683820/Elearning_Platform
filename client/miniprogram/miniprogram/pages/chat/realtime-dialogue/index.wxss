/* 实时语音对话页面（REST 模式） */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg, #F5F7FA);
  --primary: #5B9E6F;
  --primary-bg: #dcfce7;
  --primary-light: #7AB88A;
  --gradient: linear-gradient(135deg, #5B9E6F 0%, #7AB88A 100%);
  --text-primary: #1F2937;
  --text-secondary: #6B7280;
  --text-muted: #9CA3AF;
  --border-light: #E5E7EB;
  --border-lighter: #F3F4F6;
}

/* ===== 顶部导航 ===== */
.header {
  background: var(--gradient);
  color: #FFFFFF;
  flex-shrink: 0;
  padding-left: 32rpx;
  padding-right: 32rpx;
}
.header-inner {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.back-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 12rpx;
  border-radius: 16rpx;
  background: rgba(255,255,255,0.15);
  flex-shrink: 0;
}
.back-icon { font-size: 36rpx; line-height: 1; }
.back-text { font-size: 24rpx; font-weight: 500; }
.header-center {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}
.header-title {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.header-scene {
  font-size: 20rpx;
  color: rgba(255,255,255,0.7);
}

/* ===== 状态指示 ===== */
.status-indicator {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  flex-shrink: 0;
  background: rgba(255,255,255,0.15);
}
.status-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #4CAF50;
}
.status-indicator.recording .status-dot {
  background: #FF5722;
  animation: blink 0.6s infinite;
}
.status-indicator.uploading .status-dot {
  background: #FFC107;
  animation: blink 1s infinite;
}
.status-indicator.playing .status-dot {
  background: #2196F3;
}
.status-indicator.error .status-dot {
  background: #FF3B30;
}
.status-text { font-size: 20rpx; }

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

/* ===== 主区域 ===== */
.main-area {
  flex: 1;
  overflow: hidden;
  position: relative;
}

/* ===== 场景选择 ===== */
.scene-picker {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 32rpx;
  gap: 12rpx;
}
.scene-picker-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.scene-picker-desc {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 32rpx;
}
.scene-grid {
  white-space: nowrap;
  padding: 0 8rpx 16rpx 8rpx;
}
.scene-grid .scene-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 28rpx 32rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  min-width: 160rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  transition: all 0.2s;
  border: 2rpx solid transparent;
  flex-shrink: 0;
}
.scene-card:active { transform: scale(0.95); }
.scene-card-active {
  border-color: var(--primary);
  background: var(--primary-bg);
  box-shadow: 0 4rpx 20rpx rgba(91,158,111,0.2);
}
/* 场景卡片图标已移除 */
.scene-card-name {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* ===== 错误提示 ===== */
.error-card {
  margin: 32rpx;
  padding: 40rpx 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 2rpx 16rpx rgba(255,59,48,0.1);
}
.error-icon {
  font-size: 48rpx;
  font-weight: 800;
  color: #FF3B30;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #fef2f2;
  display: flex;
  align-items: center;
  justify-content: center;
}
.error-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  text-align: center;
  line-height: 1.6;
}
.error-retry {
  margin-top: 12rpx;
  padding: 16rpx 48rpx;
  background: var(--gradient);
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: 600;
}

/* ===== 消息列表 ===== */
.msg-list {
  height: 100%;
  box-sizing: border-box;
}
.msg-scroll-inner {
  display: flex;
  flex-direction: column;
  padding: 24rpx 32rpx;
  padding-bottom: 40rpx;
  gap: 24rpx;
  min-height: 100%;
}
.msg-bottom { height: 1rpx; }

/* ===== 系统提示 ===== */
.system-tip {
  display: flex;
  justify-content: center;
  padding: 16rpx 0;
}
.system-tip-text {
  font-size: 22rpx;
  color: var(--text-muted);
  background: var(--border-lighter);
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
}

/* ===== 消息行 ===== */
.msg-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}
.msg-user { flex-direction: row-reverse; }
.msg-ai { flex-direction: row; }

/* ===== 头像 ===== */
.msg-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.avatar-ai { background: var(--gradient); }
.avatar-text {
  font-size: 22rpx;
  font-weight: 600;
  color: #FFFFFF;
}

/* ===== 文字折叠（主打听和说） ===== */
.collapsed-overlay {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 20rpx 16rpx;
  min-height: 60rpx;
  cursor: pointer;
  opacity: 0.5;
  transition: opacity 0.2s;
}
.collapsed-overlay:active { opacity: 0.8; }
.collapsed-text {
  font-size: 24rpx;
  color: var(--text-muted);
  letter-spacing: 1rpx;
}
.collapsed-icon { font-size: 32rpx; }
.bubble-user .collapsed-text { color: rgba(255,255,255,0.6); }
.bubble-user .collapsed-overlay { opacity: 0.4; }

/* ===== 评分卡片 ===== */
.score-card {
  max-width: 80%;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(91,158,111,0.15);
  border: 2rpx solid var(--primary-bg);
  margin: 0 auto;
  width: 100%;
  box-sizing: border-box;
}
.score-header { text-align: center; margin-bottom: 20rpx; }
.score-title { font-size: 30rpx; font-weight: 700; color: var(--text-primary); }
.score-circle-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
}
.score-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--gradient);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(91,158,111,0.3);
}
.score-number {
  font-size: 52rpx;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1;
}
.score-max {
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
  margin-top: 4rpx;
}
.score-feedback {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.7;
  padding: 16rpx 0;
  border-top: 1rpx solid var(--border-lighter);
  margin-top: 8rpx;
}
.score-dims {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 16rpx;
}
.score-dim { display: flex; flex-direction: column; gap: 6rpx; }
.dim-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}
.dim-item {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  padding-left: 8rpx;
}

/* ===== 消息气泡 ===== */
.msg-bubble {
  max-width: 70%;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  line-height: 1.7;
  word-break: break-word;
  box-sizing: border-box;
}
.bubble-ai {
  background: #FFFFFF;
  color: var(--text-primary);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
  border-bottom-left-radius: 8rpx;
}
.bubble-user {
  background: var(--gradient);
  color: #FFFFFF;
  border-bottom-right-radius: 8rpx;
}
.msg-time {
  display: block;
  font-size: 18rpx;
  color: var(--text-muted);
  margin-bottom: 8rpx;
  opacity: 0.6;
}
.bubble-user .msg-time { color: rgba(255,255,255,0.6); }
.msg-content { display: block; }

/* ===== Thinking 动画 ===== */
.thinking-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.thinking-label {
  font-size: 24rpx;
  color: var(--text-muted);
}
.thinking-dots { display: flex; gap: 6rpx; }
.thinking-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--primary);
  animation: bounce 1.4s ease-in-out infinite;
}
.thinking-dot:nth-child(2) { animation-delay: 0.2s; }
.thinking-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes bounce {
  0%, 80%, 100% { opacity: 0.3; transform: scale(0.7); }
  40% { opacity: 1; transform: scale(1); }
}

/* ===== 底部操作栏 ===== */
.bottom-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  padding: 20rpx 32rpx;
  background: #FFFFFF;
  border-top: 1rpx solid var(--border-light);
  flex-shrink: 0;
}

/* 场景名 */
.scene-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
  flex-shrink: 0;
}
.scene-label-text {
  font-size: 22rpx;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 140rpx;
}

/* 麦克风按钮 */
.mic-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}
.mic-wrap {
  width: 148rpx;
  height: 148rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}
.mic-wrap.mic-recording {
  box-shadow: 0 0 0 20rpx rgba(220,38,38,0.10);
}
.mic-btn {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--gradient);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 28rpx rgba(91,158,111,0.4);
  transition: all 0.2s;
}
.mic-btn:active { transform: scale(0.92); }
.mic-btn-active {
  background: #dc2626;
  box-shadow: 0 0 0 10rpx rgba(220,38,38,0.2);
  animation: mic-pulse 1s ease-in-out infinite;
}
.mic-btn-playing {
  background: #2196F3;
  box-shadow: 0 0 0 10rpx rgba(33,150,243,0.2);
  animation: mic-pulse 1s ease-in-out infinite;
}
.mic-icon {
  font-size: 48rpx;
  font-weight: 800;
  color: #FFFFFF;
}
.mic-hint {
  font-size: 22rpx;
  color: var(--text-muted);
  white-space: nowrap;
}

@keyframes mic-pulse {
  0%, 100% { box-shadow: 0 0 0 16rpx rgba(220,38,38,0.12); }
  50% { box-shadow: 0 0 0 28rpx rgba(220,38,38,0.06); }
}

/* 操作按钮 */
.action-area {
  display: flex;
  flex-shrink: 0;
  gap: 16rpx;
}
.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx;
  border-radius: 16rpx;
  transition: all 0.2s;
}
.action-btn:active { background: var(--border-lighter); }
.clear-icon-wrap, .end-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--border-lighter);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}
.clear-icon-wrap:active, .end-icon-wrap:active { transform: scale(0.92); }
.end-icon-wrap { background: #fef3c7; }
.action-icon {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text-primary);
}
.action-text {
  font-size: 20rpx;
  color: var(--text-secondary);
  font-weight: 500;
}
