.page { min-height: 100vh; background: #f5f7fa; padding-bottom: 120rpx; }

.loading-state { display: flex; flex-direction: column; align-items: center; padding-top: 300rpx; }
.loading-spinner { width: 60rpx; height: 60rpx; border: 4rpx solid #e5e7eb; border-top-color: #5b9e6f; border-radius: 50%; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: 28rpx; color: #9ca3af; margin-top: 20rpx; }

.error-state { display: flex; flex-direction: column; align-items: center; padding-top: 300rpx; }
.error-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.error-text { font-size: 28rpx; color: #9ca3af; margin-bottom: 32rpx; }
.retry-btn { background: #5b9e6f; color: #fff; font-size: 28rpx; padding: 16rpx 64rpx; border-radius: 50rpx; border: none; }

.video-section { }
.player-wrapper { position: relative; width: 100%; height: 480rpx; background: #000; }
.video-player { width: 100%; height: 100%; }

.processing-overlay { position: absolute; inset: 0; background: rgba(0,0,0,0.7); display: flex; flex-direction: column; align-items: center; justify-content: center; }
.processing-icon { font-size: 80rpx; margin-bottom: 16rpx; }
.processing-text { font-size: 32rpx; color: #fff; font-weight: 600; }
.processing-progress { font-size: 26rpx; color: #e5e7eb; margin-top: 8rpx; }

.info-section { padding: 24rpx 32rpx; }
.info-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24rpx; }
.info-left { flex: 1; }
.video-title { font-size: 34rpx; font-weight: 700; color: #1f2937; display: block; margin-bottom: 8rpx; }
.video-meta { display: flex; gap: 16rpx; }
.meta-unit { font-size: 24rpx; color: #9ca3af; }
.meta-duration { font-size: 24rpx; color: #9ca3af; }

.info-actions { display: flex; gap: 24rpx; }
.info-actions .action-btn { display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.info-actions .action-btn text:first-child { font-size: 36rpx; }
.info-actions .action-btn .action-label { font-size: 22rpx; color: #6b7280; }
.info-actions .action-btn.favorited .action-label { color: #f59e0b; }

.character-card { display: flex; align-items: center; gap: 20rpx; background: #fff; border-radius: 16rpx; padding: 20rpx; margin-bottom: 24rpx; }
.char-avatar { width: 80rpx; height: 80rpx; border-radius: 50%; }
.char-info { flex: 1; }
.char-name { font-size: 30rpx; font-weight: 600; color: #1f2937; display: block; }
.char-role { font-size: 24rpx; color: #9ca3af; margin-top: 4rpx; display: block; }

.script-section { margin-bottom: 24rpx; }
.script-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.script-title { font-size: 28rpx; font-weight: 700; color: #1f2937; }

.script-list { display: flex; flex-direction: column; gap: 12rpx; max-height: 500rpx; overflow-y: auto; }
.script-item { display: flex; gap: 12rpx; background: #fff; border-radius: 12rpx; padding: 16rpx; border: 2rpx solid transparent; }
.script-item.active { border-color: #5b9e6f; background: #f0fdf4; }
.script-num { width: 32rpx; height: 32rpx; background: #e5e7eb; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 18rpx; color: #6b7280; flex-shrink: 0; margin-top: 4rpx; }
.script-item.active .script-num { background: #5b9e6f; color: #fff; }
.script-body { flex: 1; }
.script-text { font-size: 26rpx; color: #374151; line-height: 1.6; display: block; }
.script-footer { display: flex; gap: 12rpx; margin-top: 8rpx; flex-wrap: wrap; }
.script-emotion { font-size: 20rpx; color: #f59e0b; background: #fffbeb; padding: 2rpx 12rpx; border-radius: 12rpx; }
.script-translation { font-size: 22rpx; color: #6b7280; }

.stats-bar { display: flex; justify-content: space-between; font-size: 24rpx; color: #9ca3af; }

.bottom-actions { position: fixed; bottom: 0; left: 0; right: 0; padding: 20rpx 32rpx; background: #fff; box-shadow: 0 -4rpx 12rpx rgba(0,0,0,0.06); }
.replay-btn { width: 100%; background: #5b9e6f; color: #fff; font-size: 28rpx; padding: 20rpx; border-radius: 16rpx; border: none; }
