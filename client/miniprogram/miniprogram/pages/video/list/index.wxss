.page { min-height: 100vh; background: #f5f7fa; padding-bottom: 20rpx; }

.page-header { padding: 32rpx 32rpx 16rpx; }
.page-title { font-size: 36rpx; font-weight: 700; color: #1f2937; display: block; }
.page-subtitle { font-size: 26rpx; color: #9ca3af; margin-top: 8rpx; display: block; }

.filter-bar { display: flex; justify-content: space-between; align-items: center; padding: 0 32rpx 16rpx; }
.filter-tabs { display: flex; gap: 16rpx; }
.filter-tab { font-size: 26rpx; color: #6b7280; padding: 6rpx 20rpx; border-radius: 30rpx; background: #fff; }
.filter-tab.active { color: #fff; background: #5b9e6f; font-weight: 600; }
.create-btn { display: flex; align-items: center; gap: 8rpx; font-size: 26rpx; color: #5b9e6f; font-weight: 600; }
.create-icon { font-size: 32rpx; }

.loading-state { display: flex; flex-direction: column; align-items: center; padding-top: 200rpx; }
.loading-spinner { width: 60rpx; height: 60rpx; border: 4rpx solid #e5e7eb; border-top-color: #5b9e6f; border-radius: 50%; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: 26rpx; color: #9ca3af; margin-top: 20rpx; }

.empty-state { display: flex; flex-direction: column; align-items: center; padding-top: 200rpx; padding-horizontal: 60rpx; }
.empty-icon { font-size: 100rpx; margin-bottom: 24rpx; }
.empty-title { font-size: 32rpx; font-weight: 600; color: #374151; margin-bottom: 12rpx; }
.empty-desc { font-size: 26rpx; color: #9ca3af; text-align: center; line-height: 1.6; margin-bottom: 40rpx; padding-horizontal: 40rpx; }
.empty-btn { background: #5b9e6f; color: #fff; font-size: 28rpx; padding: 20rpx 80rpx; border-radius: 50rpx; border: none; }

.video-list { padding: 0 32rpx; }
.video-card { background: #fff; border-radius: 16rpx; margin-bottom: 20rpx; overflow: hidden; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06); }
.card-thumb { position: relative; height: 320rpx; }
.thumb-img { width: 100%; height: 100%; }
.card-status { position: absolute; top: 16rpx; left: 16rpx; font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 20rpx; color: #fff; }
.card-status.completed { background: #5b9e6f; }
.card-status.processing { background: #f59e0b; }
.card-status.failed { background: #ef4444; }
.card-duration { position: absolute; bottom: 16rpx; right: 16rpx; font-size: 22rpx; color: #fff; background: rgba(0,0,0,0.6); padding: 4rpx 12rpx; border-radius: 12rpx; }

.card-info { padding: 24rpx; }
.card-title { font-size: 30rpx; font-weight: 600; color: #1f2937; display: block; margin-bottom: 12rpx; }
.card-meta { display: flex; gap: 16rpx; margin-bottom: 16rpx; }
.card-character { font-size: 24rpx; color: #5b9e6f; background: #e8f5e9; padding: 4rpx 16rpx; border-radius: 20rpx; }
.card-unit { font-size: 24rpx; color: #6b7280; background: #f3f4f6; padding: 4rpx 16rpx; border-radius: 20rpx; }

.card-stats { display: flex; align-items: center; gap: 20rpx; }
.stat-item { font-size: 24rpx; color: #9ca3af; }
.stat-date { font-size: 22rpx; color: #b9bdc7; margin-left: auto; }

.load-more { text-align: center; padding: 32rpx; }
.load-more text { font-size: 26rpx; color: #5b9e6f; }
