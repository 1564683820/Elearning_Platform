<!-- 我的视频列表页 -->
<view class="page">
  <view class="page-header">
    <text class="page-title">我的视频</text>
    <text class="page-subtitle">AI 教材演绎视频，生动学习</text>
  </view>

  <view class="filter-bar" wx:if="{{videos.length > 0}}">
    <view class="filter-tabs">
      <view class="filter-tab {{filterStatus === '' ? 'active' : ''}}" bindtap="onFilterAll">全部</view>
      <view class="filter-tab {{filterStatus === 'completed' ? 'active' : ''}}" bindtap="onFilterCompleted">已完成</view>
      <view class="filter-tab {{filterStatus === 'processing' ? 'active' : ''}}" bindtap="onFilterProcessing">生成中</view>
    </view>
    <view class="create-btn" bindtap="onGoCreate">
      <text class="create-icon">+</text>
      <text>创建视频</text>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{loading && videos.length === 0}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:elif="{{!loading && videos.length === 0}}">
    <view class="empty-icon"></view>
    <text class="empty-title">还没有演绎视频</text>
    <text class="empty-desc">选择课文和角色，AI 为你生成生动的教材演绎视频</text>
    <button class="empty-btn" bindtap="onGoCreate">立即创建</button>
  </view>

  <!-- 视频列表 -->
  <view class="video-list" wx:elif="{{videos.length > 0}}">
    <view
      class="video-card"
      wx:for="{{videos}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onVideoTap"
    >
      <view class="card-thumb">
        <image
          class="thumb-img"
          src="{{item.thumbnail_url || '/images/video-default.png'}}"
          mode="aspectFill"
        />
        <view class="card-status {{item.status}}">
          {{item.status === 'completed' ? '已完成' : item.status === 'processing' ? '生成中...' : item.status === 'failed' ? '失败' : '等待中'}}
        </view>
        <view class="card-duration">{{formatDuration(item.duration)}}</view>
      </view>
      <view class="card-info">
        <text class="card-title">{{item.title}}</text>
        <view class="card-meta">
          <text class="card-character">{{item.character_type_name}}</text>
          <text class="card-unit">{{item.unit_name || item.textbook_grade}}</text>
        </view>
        <view class="card-stats">
          <text class="stat-item">👁 {{item.view_count || 0}}</text>
          <text class="stat-item">⭐ {{item.favorite_count || 0}}</text>
          <text class="stat-date">{{formatDate(item.created_at)}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{hasMore && !loading}}">
    <text bindtap="onLoadMore">加载更多</text>
  </view>
</view>
