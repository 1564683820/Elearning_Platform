/* 首页样式 */
.container {
  padding: 0 32rpx 32rpx;
  background: #F0F4F0;
  min-height: 100vh;
}

/* 顶部栏 */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  background: #FFFFFF;
  margin: 0 -32rpx;
}

.logo-area {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.logo-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 24rpx;
  background: #E8F5E9;
  color: #5B9E6F;
  font-size: 32rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #1F2937;
}

.phase-selector {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  border-radius: 99rpx;
  background: #E8F5E9;
}

.phase-text {
  font-size: 26rpx;
  color: #5B9E6F;
  font-weight: 600;
}

.phase-arrow {
  font-size: 20rpx;
  color: #5B9E6F;
  transition: transform 0.3s;
}

.phase-arrow.up {
  transform: rotate(180deg);
}

/* 下拉菜单 */
.dropdown-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
}

.dropdown-menu {
  position: absolute;
  top: 120rpx;
  right: 32rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 16rpx 0;
  box-shadow: 0 16rpx 60rpx rgba(0,0,0,0.15);
  min-width: 280rpx;
  z-index: 101;
  overflow: hidden;
}

.dropdown-item {
  padding: 24rpx 40rpx;
  font-size: 28rpx;
  color: #6B7B8D;
}

.dropdown-item.active {
  color: #5B9E6F;
  font-weight: 600;
  background: #E8F5E9;
}

/* 主标题区 */
.home-header {
  padding: 28rpx 8rpx 16rpx;
}

.home-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #1F2937;
}

.home-subtitle {
  display: block;
  font-size: 24rpx;
  color: #6B7B8D;
  margin-top: 4rpx;
}

/* 学习统计行 — 原型 stat-row */
.stats-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-item {
  flex: 1;
  background: #E8F5E9;
  border-radius: 14rpx;
  padding: 20rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.stat-num {
  font-size: 42rpx;
  font-weight: 800;
  color: #5B9E6F;
  line-height: 1.1;
}

.stat-lbl {
  font-size: 22rpx;
  color: #6B7B8D;
}

/* 2×2 功能入口网格 */
.entry-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.entry-item {
  background: #FFFFFF;
  border-radius: 18rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  position: relative;
  transition: all 0.15s;
}

.entry-item:active {
  transform: scale(0.96);
  opacity: 0.85;
}

.entry-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  margin: 0 auto 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.entry-icon-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #374151;
}

.entry-name {
  display: block;
  font-weight: 700;
  font-size: 28rpx;
  color: #1F2937;
}

.vip-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  background: #F5A623;
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  font-weight: 700;
}

/* 班级通知 */
.notice-card {
  background: #FFFFFF;
  border-radius: 18rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.notice-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.notice-title {
  font-weight: 700;
  font-size: 30rpx;
  color: #1F2937;
}

.notice-header-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.notice-count {
  font-size: 22rpx;
  color: #4A90D9;
  font-weight: 600;
}

.notice-all-link {
  font-size: 22rpx;
  color: #5B9E6F;
  font-weight: 600;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
}

.notice-all-link:active {
  background: #E8F5E9;
}

.notice-body {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.notice-item {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  padding: 16rpx 12rpx;
  border-radius: 12rpx;
  transition: background 0.15s;
}

.notice-item:active {
  background: #F0F4F0;
}

.notice-dot {
  font-size: 24rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.notice-content-wrap {
  flex: 1;
  min-width: 0;
}

.notice-content {
  display: block;
  font-size: 26rpx;
  color: #374151;
  line-height: 1.5;
  word-break: break-all;
}

/* 通知项中的试卷 meta 信息 */
.notice-exam-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 6rpx;
}

.meta-tag {
  font-size: 20rpx;
  color: #9CA3AF;
  background: #F3F4F6;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
  line-height: 1.6;
}

.meta-tag.tag-diff-1 {
  color: #5B9E6F;
  background: #E8F5E9;
}

.meta-tag.tag-diff-2 {
  color: #D68D1A;
  background: #FFF8E1;
}

.meta-tag.tag-diff-3 {
  color: #D9534F;
  background: #FFEBEE;
}

.notice-go {
  font-size: 32rpx;
  color: #D1D5DB;
  flex-shrink: 0;
  margin-top: 6rpx;
}

/* 底部加载提示 */
.loading-footer {
  text-align: center;
  padding: 20rpx;
  font-size: 24rpx;
  color: #9CA3AF;
}

/* ========== 保存提示弹窗 ========== */
.tip-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s;
}
.tip-overlay.show {
  opacity: 1;
  pointer-events: auto;
}

.tip-box {
  width: 520rpx;
  background: #FFFFFF;
  border-radius: 40rpx;
  padding: 48rpx 36rpx 36rpx;
  text-align: center;
  box-shadow: 0 40rpx 120rpx rgba(0,0,0,0.2);
}

.tip-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.tip-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1F2937;
  margin-bottom: 12rpx;
}

.tip-desc {
  font-size: 26rpx;
  color: #6B7280;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.tip-highlight {
  color: #5B9E6F;
  font-weight: 700;
}

.tip-btn {
  width: 100%;
  padding: 24rpx 0;
  background: linear-gradient(135deg, #5B9E6F 0%, #7AB88A 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 24rpx;
  border: none;
  line-height: 1;
}
.tip-btn::after {
  border: none;
}
