.page { padding: 20px 16px; min-height: 100vh; background: #F5F7FA; }
.result-header { text-align: center; margin-bottom: 24px; }
.score-circle { width: 100px; height: 100px; border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; margin: 0 auto 12px; }
.score-circle.excellent { background: linear-gradient(135deg, #5B9E6F, #3d7a4e); }
.score-circle.good { background: linear-gradient(135deg, #3498db, #2980b9); }
.score-circle.pass { background: linear-gradient(135deg, #e67e22, #d35400); }
.score-circle.fail { background: linear-gradient(135deg, #e74c3c, #c0392b); }
.score-text { font-size: 36px; font-weight: 700; color: #fff; }
.score-label { font-size: 12px; color: rgba(255,255,255,0.8); }
.exam-title { font-size: 18px; font-weight: 600; color: #1a1a2e; display: block; margin-top: 8px; }
.grade-text { font-size: 14px; color: #888; margin-top: 4px; display: block; }
.section { background: #fff; border-radius: 12px; padding: 16px; margin-bottom: 16px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }
.section-title { font-size: 16px; font-weight: 600; color: #333; margin-bottom: 12px; display: block; }
.answer-item { padding: 12px 0; border-bottom: 1px solid #f0f2f5; }
.answer-item:last-child { border-bottom: none; }
.a-header { display: flex; align-items: center; margin-bottom: 6px; }
.q-num { font-size: 14px; font-weight: 700; color: #5B9E6F; margin-right: 6px; }
.q-type { font-size: 11px; color: #888; background: #f0f2f5; padding: 1px 6px; border-radius: 4px; margin-right: auto; }
.q-score { font-size: 13px; font-weight: 600; }
.q-text { font-size: 14px; color: #333; margin-bottom: 8px; display: block; line-height: 1.5; }
.a-row { display: flex; margin-bottom: 4px; font-size: 13px; }
.a-label { color: #888; min-width: 60px; }
.a-value { color: #333; flex: 1; }
.a-comment { margin-top: 6px; padding: 6px 10px; background: #fff8e1; border-radius: 6px; font-size: 12px; color: #666; }
.bottom-actions { margin-top: 20px; padding-bottom: 30px; }
.action-btn { background: #5B9E6F; color: #fff; border-radius: 10px; padding: 12px; font-size: 15px; font-weight: 600; }
