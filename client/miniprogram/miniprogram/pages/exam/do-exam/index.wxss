/* 答题页 — 上下分屏样式 */

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F5F7FA;
  overflow: hidden;
}

/* ====== 顶部Header ====== */

.exam-header {
  flex-shrink: 0;
  background: linear-gradient(135deg, #1a1a2e, #16213e);
  padding: 14px 20px 12px;
}

.exam-title {
  font-size: 17px;
  font-weight: 700;
  color: #fff;
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.header-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 6px;
}

.timer {
  font-size: 14px;
  color: #f0c040;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.q-progress {
  font-size: 13px;
  color: rgba(255,255,255,0.7);
  font-weight: 500;
}

/* ====== 上半区域：文章/大题 ====== */

.top-passage {
  flex: 1;
  min-height: 0;
  padding: 16px 20px;
  background: #fff;
  overflow-y: auto;
}

.passage-label {
  font-size: 13px;
  color: #5B9E6F;
  font-weight: 600;
  margin-bottom: 10px;
  letter-spacing: 0.5px;
}

.passage-text {
  font-size: 15px;
  color: #374151;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-word;
}

.big-question {
  font-size: 16px;
  color: #1F2937;
  line-height: 1.7;
  font-weight: 500;
  white-space: pre-wrap;
  word-break: break-word;
}

/* ====== 分隔线 ====== */

.divider {
  flex-shrink: 0;
  height: 2px;
  background: linear-gradient(90deg, transparent, #5B9E6F 20%, #5B9E6F 80%, transparent);
  opacity: 0.3;
}

/* ====== 下半区域：小题 + 选项 ====== */

.bottom-qa {
  flex-shrink: 0;
  max-height: 58vh;
  padding: 14px 20px 8px;
  background: #fff;
  overflow-y: auto;
}

.q-header {
  display: flex;
  align-items: baseline;
  gap: 8px;
  margin-bottom: 10px;
}

.q-number {
  font-size: 16px;
  font-weight: 700;
  color: #5B9E6F;
}

.q-type-label {
  font-size: 12px;
  color: #9CA3AF;
}

.q-subject {
  display: block;
  font-size: 15px;
  color: #374151;
  line-height: 1.5;
  margin-bottom: 12px;
  font-weight: 500;
}

/* ====== 选择题选项 ====== */

.options-wrap {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.option-item {
  display: flex;
  align-items: center;
  padding: 12px 14px;
  border-radius: 10px;
  border: 1.5px solid #E5E7EB;
  background: #FAFBFC;
  transition: all 0.15s;
}

.option-item:active {
  background: #F0F4F0;
}

.option-item.selected {
  border-color: #5B9E6F;
  background: #F0FAF3;
}

.option-radio {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  border: 2px solid #D1D5DB;
  margin-right: 12px;
  flex-shrink: 0;
  position: relative;
  transition: all 0.15s;
}

.option-radio.active {
  border-color: #5B9E6F;
  background: #5B9E6F;
}

.option-radio.active::after {
  content: '';
  position: absolute;
  top: 4px;
  left: 4px;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #fff;
}

.option-text {
  font-size: 15px;
  color: #333;
  line-height: 1.4;
  flex: 1;
}

.no-options {
  font-size: 13px;
  color: #9CA3AF;
  text-align: center;
  padding: 16px 0;
}

/* ====== 填空/文本输入 ====== */

.fill-input {
  border: 1.5px solid #E5E7EB;
  border-radius: 10px;
  padding: 12px 14px;
  font-size: 15px;
  width: 100%;
  box-sizing: border-box;
  background: #FAFBFC;
}

.fill-input:focus {
  border-color: #5B9E6F;
  outline: none;
}

.text-input {
  border: 1.5px solid #E5E7EB;
  border-radius: 10px;
  padding: 12px 14px;
  font-size: 15px;
  width: 100%;
  min-height: 120px;
  box-sizing: border-box;
  background: #FAFBFC;
  line-height: 1.6;
}

.text-input:focus {
  border-color: #5B9E6F;
  outline: none;
}

.unknown-type {
  font-size: 13px;
  color: #D9534F;
  text-align: center;
  display: block;
  padding: 12px 0;
}

/* ====== 阅读题子题 ====== */

.reading-sub-wrap {
  margin-bottom: 14px;
  padding-bottom: 14px;
  border-bottom: 1px dashed #E5E7EB;
}

.reading-sub-wrap:last-child {
  border-bottom: none;
  margin-bottom: 0;
}

.reading-sub-label {
  display: inline-block;
  font-size: 12px;
  color: #5B9E6F;
  background: #E8F5E9;
  border-radius: 4px;
  padding: 2px 8px;
  margin-bottom: 6px;
  font-weight: 600;
}

/* ====== 上下题导航 ====== */

.nav-buttons {
  display: flex;
  gap: 10px;
  margin-top: 14px;
  padding-bottom: 4px;
}

.nav-btn {
  flex: 1;
  height: 40px;
  border-radius: 10px;
  font-size: 14px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.nav-btn.prev {
  background: #F3F4F6;
  color: #6B7280;
}

.nav-btn.next {
  background: #5B9E6F;
  color: #fff;
}

.nav-btn[disabled] {
  opacity: 0.4;
}

/* ====== 底部提交栏 ====== */

.submit-bar {
  flex-shrink: 0;
  background: #fff;
  padding: 10px 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1px solid #F0F0F0;
}

.progress-text {
  font-size: 13px;
  color: #9CA3AF;
}

.submit-btn {
  background: linear-gradient(135deg, #5B9E6F, #3d7a4e);
  color: #fff;
  border-radius: 10px;
  padding: 10px 28px;
  font-size: 14px;
  font-weight: 600;
  border: none;
}

.submit-btn[disabled] {
  background: #ccc;
  color: #fff;
}
