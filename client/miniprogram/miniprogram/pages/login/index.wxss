/* 登录/注册页样式 */
.page {
  min-height: 100vh;
  background: linear-gradient(160deg, #E8F5E9 0%, #F0F4F0 50%, #F9FBE7 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 32rpx;
  box-sizing: border-box;
}

.login-card {
  width: 100%;
  max-width: 600rpx;
  background: #FFFFFF;
  border-radius: 48rpx;
  padding: 60rpx 48rpx;
  box-shadow: 0 16rpx 80rpx rgba(91, 158, 111, 0.12);
}

/* Logo 区域 */
.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.logo-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #5B9E6F 0%, #7AB88A 100%);
  color: #FFFFFF;
  font-size: 44rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.logo-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #1F2937;
}

.logo-subtitle {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-top: 6rpx;
}

/* Tab 切换 */
.tab-bar {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  margin-bottom: 40rpx;
  border-bottom: 2rpx solid #F3F4F6;
  padding-bottom: 16rpx;
}

.tab-item {
  font-size: 30rpx;
  color: #9CA3AF;
  font-weight: 500;
  padding: 0 8rpx 8rpx;
  position: relative;
}

.tab-item.active {
  color: #5B9E6F;
  font-weight: 700;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: -18rpx;
  left: 0;
  right: 0;
  height: 4rpx;
  background: #5B9E6F;
  border-radius: 2rpx;
}

/* 表单 */
.form {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.input-group {
  margin-bottom: 24rpx;
}

.input-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #374151;
  margin-bottom: 12rpx;
}

.input-field {
  width: 100%;
  height: 88rpx;
  background: #F3F4F6;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #1F2937;
  box-sizing: border-box;
}

.input-field::placeholder {
  color: #D1D5DB;
}

/* 按钮 */
.login-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  background: linear-gradient(135deg, #5B9E6F 0%, #7AB88A 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 46rpx;
  text-align: center;
  margin-top: 16rpx;
  border: none;
}

.login-btn::after {
  border: none;
}

.login-btn[loading] {
  opacity: 0.8;
}

.login-btn:not([disabled]):active {
  opacity: 0.85;
  transform: scale(0.97);
}

/* 错误提示 */
.error-tip {
  text-align: center;
  font-size: 24rpx;
  color: #EF4444;
  margin-top: 16rpx;
  padding: 12rpx;
  background: #FEF2F2;
  border-radius: 12rpx;
}

/* 提示文字 */
.hint-text {
  text-align: center;
  font-size: 26rpx;
  color: #9CA3AF;
  margin-top: 28rpx;
}

.link {
  color: #5B9E6F;
  font-weight: 600;
}

.link:active {
  opacity: 0.7;
}

/* 角色选择器 */
.role-selector {
  display: flex;
  gap: 20rpx;
}

.role-option {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 88rpx;
  background: #F3F4F6;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #6B7280;
  font-weight: 500;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.role-option:active {
  opacity: 0.8;
}

.role-option.role-active {
  background: #ECFDF5;
  border-color: #5B9E6F;
  color: #5B9E6F;
  font-weight: 600;
}

.role-icon {
  font-size: 32rpx;
}
