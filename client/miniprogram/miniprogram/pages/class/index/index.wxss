.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 48rpx;
}

/* 顶部 */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  background: var(--card);
  position: sticky;
  top: 0;
  z-index: 10;
}

.top-title {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.join-btn-sm {
  padding: 12rpx 28rpx;
  border-radius: 99rpx;
  background: var(--primary);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  border: none;
  line-height: 1.4;
}

.join-btn-sm::after {
  border: none;
}

/* 班级列表 */
.class-list {
  padding: 0 32rpx;
}

.class-card {
  background: var(--card);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
}

.card-top {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.card-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: var(--gradient);
  color: #fff;
  font-size: 32rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.card-info {
  flex: 1;
  min-width: 0;
}

.card-name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.3;
}

.card-teacher {
  display: block;
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}

.card-arrow {
  font-size: 32rpx;
  color: var(--text-light);
  flex-shrink: 0;
}

.card-desc {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-light);
  line-height: 1.5;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-muted);
  margin-bottom: 48rpx;
}

.empty-btn {
  padding: 20rpx 60rpx;
  border-radius: 99rpx;
  background: var(--primary);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

.empty-btn::after {
  border: none;
}

/* 加载 */
.loading-view {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
  font-size: 28rpx;
  color: var(--text-muted);
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 580rpx;
  background: var(--card);
  border-radius: var(--radius-xl);
  padding: 48rpx 40rpx;
}

.modal-title {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: var(--text-primary);
  text-align: center;
  margin-bottom: 12rpx;
}

.modal-desc {
  display: block;
  font-size: 26rpx;
  color: var(--text-muted);
  text-align: center;
  margin-bottom: 36rpx;
}

.modal-input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-md);
  padding: 0 28rpx;
  font-size: 30rpx;
  color: var(--text-primary);
  box-sizing: border-box;
  margin-bottom: 40rpx;
  text-align: center;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-btn::after {
  border: none;
}

.modal-btn.cancel {
  background: var(--border-light);
  color: var(--text-secondary);
}

.modal-btn.confirm {
  background: var(--gradient);
  color: #fff;
}

.modal-btn.loading {
  opacity: 0.7;
}
