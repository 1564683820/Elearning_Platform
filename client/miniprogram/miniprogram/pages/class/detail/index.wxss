/* 班级详情 */
.page {
  min-height: 100vh;
  background: #F5F7FA;
  padding: 24rpx 32rpx 48rpx;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 班级信息卡片 */
.class-card {
  background: linear-gradient(135deg, #5B9E6F 0%, #7AB88A 100%);
  border-radius: 24rpx;
  padding: 36rpx;
  margin-bottom: 24rpx;
  color: #FFFFFF;
}

.class-badge {
  display: inline-block;
  background: rgba(255,255,255,0.2);
  border-radius: 99rpx;
  padding: 6rpx 20rpx;
  font-size: 22rpx;
  margin-bottom: 16rpx;
}

.class-name {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
}

.class-teacher {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  margin-bottom: 16rpx;
}

.class-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  line-height: 1.6;
  margin-bottom: 24rpx;
  padding: 16rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 12rpx;
}

.class-meta {
  display: flex;
  gap: 24rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255,255,255,0.12);
  padding: 10rpx 20rpx;
  border-radius: 99rpx;
}

.meta-icon {
  font-size: 24rpx;
}

.meta-text {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
}

/* 通用区块 */
.section {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.section-header {
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
}

/* 公告 */
.notice-item {
  display: flex;
  gap: 12rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.notice-item:last-child {
  border-bottom: none;
}

.notice-icon {
  flex-shrink: 0;
}

.notice-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

/* 考试列表 */
.exam-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.exam-item:last-child {
  border-bottom: none;
}

.exam-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.exam-name {
  font-size: 26rpx;
  color: #333;
}

.exam-status {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 99rpx;
  font-weight: 600;
}

.exam-status.pending {
  background: #FFF3E0;
  color: #E65100;
}

.exam-status.completed {
  background: #E8F5E9;
  color: #2E7D32;
}

.exam-arrow {
  font-size: 28rpx;
  color: #ccc;
}

/* 加入新班级按钮 */
.join-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 28rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 2rpx dashed #ddd;
  margin-top: 8rpx;
}

.join-icon {
  font-size: 28rpx;
}

.join-text {
  font-size: 28rpx;
  color: #666;
}
