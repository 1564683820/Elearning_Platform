.page { padding: 20px 16px; min-height: 100vh; background: #F5F7FA; }
.header { margin-bottom: 16px; }
.title { font-size: 22px; font-weight: 700; color: #1a1a2e; display: block; }

.exam-tabs { display: flex; margin-bottom: 16px; background: #fff; border-radius: 10px; overflow: hidden; }
.tab { flex: 1; text-align: center; padding: 10px; font-size: 14px; color: #888; }
.tab.active { color: #5B9E6F; font-weight: 600; background: #f0faf3; }

.exam-card { background: #fff; border-radius: 10px; padding: 14px 16px; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 1px 4px rgba(0,0,0,0.04); }
.exam-title { font-size: 15px; font-weight: 600; color: #333; display: block; }
.exam-meta { font-size: 12px; color: #888; margin-top: 4px; display: block; }
.exam-status { font-size: 12px; padding: 2px 8px; border-radius: 10px; }
.exam-status.published { background: #e8f5e9; color: #5B9E6F; }
.exam-status.draft { background: #fff3e0; color: #e67e22; }

.sub-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
.section-title { font-size: 16px; font-weight: 600; color: #333; }
.back-link { font-size: 13px; color: #5B9E6F; }

.submission-item { background: #fff; border-radius: 10px; padding: 12px 16px; margin-bottom: 8px; display: flex; justify-content: space-between; align-items: center; }
.sub-info { flex: 1; }
.sub-name { font-size: 15px; color: #333; display: block; }
.sub-score { font-size: 14px; font-weight: 600; display: block; margin-top: 2px; }
.review-btn { background: #fff; color: #3498db; border: 1px solid #3498db; border-radius: 6px; padding: 4px 12px; font-size: 12px; }

.empty { text-align: center; padding: 40px 0; color: #aaa; font-size: 14px; }

.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.4); display: flex; align-items: center; justify-content: center; z-index: 999; }
.modal { background: #fff; border-radius: 12px; padding: 20px; width: 85%; max-height: 70vh; overflow: auto; }
.modal-title { font-size: 16px; font-weight: 600; color: #333; display: block; margin-bottom: 8px; }
.modal-score { font-size: 14px; color: #555; display: block; margin-bottom: 16px; }
.adjust-item { display: flex; gap: 6px; margin-bottom: 8px; align-items: center; }
.adjust-label { font-size: 12px; color: #555; min-width: 50px; }
.adjust-input { flex: 1; border: 1px solid #ddd; border-radius: 6px; padding: 10px 8px; font-size: 13px; }
.add-adj { background: #f0faf3; color: #5B9E6F; border: 1px dashed #5B9E6F; border-radius: 6px; padding: 6px; font-size: 13px; margin-bottom: 16px; width: 100%; }
.modal-btns { display: flex; gap: 12px; }
.btn-cancel { flex: 1; background: #f5f5f5; color: #888; border-radius: 8px; padding: 10px; font-size: 14px; }
.btn-submit { flex: 1; background: #5B9E6F; color: #fff; border-radius: 8px; padding: 10px; font-size: 14px; }
