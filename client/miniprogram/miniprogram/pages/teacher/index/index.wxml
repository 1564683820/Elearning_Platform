<view class="page">
  <view class="header">
    <text class="title">教师工作台</text>
    <!-- 班级选择器 -->
    <picker wx:if="{{classList.length > 0}}" mode="selector"
            range="{{classList}}" range-key="name"
            value="{{classIndex}}"
            bindchange="onClassChange">
      <view class="class-picker">
        <text class="picker-label">{{className}}</text>
        <text class="picker-arrow">▼</text>
      </view>
    </picker>
  </view>

  <view class="stats-grid">
    <view class="stat-card" wx:for="{{stats}}" wx:key="label">
      <text class="stat-value">{{item.value}}</text>
      <text class="stat-label">{{item.label}}</text>
    </view>
  </view>

  <view class="section">
    <text class="section-title">高频错题 TOP 5</text>
    <view class="mistake-item" wx:for="{{mistakes}}" wx:key="index" wx:if="{{mistakes.length > 0}}">
      <text class="mistake-name">{{item.knowledge_point}}</text>
      <text class="mistake-count">{{item.count}}次</text>
    </view>
    <view class="empty" wx:if="{{mistakes.length === 0}}">
      <text>暂无数据</text>
    </view>
  </view>

  <view class="quick-actions">
    <text class="section-title">快捷操作</text>
    <view class="action-grid">
      <view class="action-btn" bindtap="goStudents">
        <text class="action-icon">学生</text>
        <text>学生管理</text>
      </view>
      <view class="action-btn" bindtap="goExams">
        <text class="action-icon">考试</text>
        <text>考试管理</text>
      </view>
      <view class="action-btn" bindtap="goGrade">
        <text class="action-icon">批卷</text>
        <text>批卷</text>
      </view>
      <view class="action-btn" bindtap="openAdmin">
        <text class="action-icon">后台</text>
        <text>管理后台</text>
      </view>
      <view class="action-btn ai-dash-btn" bindtap="onAIChatClick">
        <text class="action-icon ai-dash-icon">AI</text>
        <text>AI 助手</text>
      </view>
    </view>
  </view>

  <!-- ========== AI 问答弹窗 ========== -->
  <view class="ai-modal-mask" wx:if="{{showAIChat}}" bindtap="onCloseAIChat">
    <view class="ai-chat-modal" catchtap="preventClose">
      <view class="ai-chat-header">
        <view class="ai-chat-header-left">
          <text class="ai-chat-title">AI 教学助手</text>
          <text class="ai-chat-context">教师工作台</text>
        </view>
        <button class="modal-close-btn" bindtap="onCloseAIChat">
          <view class="close-cross"></view>
        </button>
      </view>

      <scroll-view class="ai-chat-body" scroll-y scroll-into-view="{{aiScrollToId}}" scroll-with-animation upper-threshold="50">
        <view
          class="ai-msg-wrap {{item.role === 'user' ? 'ai-msg-right' : 'ai-msg-left'}}"
          wx:for="{{aiMessages}}" wx:key="index"
        >
          <view class="ai-msg-avatar">{{item.role === 'user' ? '我' : 'AI'}}</view>
          <view class="ai-msg-bubble {{item.role === 'user' ? 'bubble-user' : 'bubble-ai'}}">
            <rich-text class="ai-msg-content" wx:if="{{!item.thinking}}" nodes="{{item.contentRendered}}"></rich-text>
            <view class="ai-thinking-row" wx:else>
              <text class="ai-thinking-dot">•</text>
              <text class="ai-thinking-dot">•</text>
              <text class="ai-thinking-dot">•</text>
            </view>
          </view>
        </view>
        <view id="ai-msg-bottom"></view>
      </scroll-view>

      <view class="ai-chat-footer">
        <input class="ai-chat-input" placeholder="输入教学问题..." value="{{aiInput}}" bindinput="onAIInput" />
        <button
          class="ai-chat-send {{(!aiInput.trim() || aiSending) ? 'send-disabled' : ''}}"
          bindtap="onAISend"
          disabled="{{aiSending}}"
        >{{aiSending ? '…' : '发送'}}</button>
      </view>
    </view>
  </view>
</view>
