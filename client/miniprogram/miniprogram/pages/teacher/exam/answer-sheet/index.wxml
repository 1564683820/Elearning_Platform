<view class="page">
  <!-- 顶部信息栏 -->
  <view class="header">
    <view class="header-title">{{examTitle || '答题卡'}}</view>
    <view class="header-meta" wx:if="{{questionCount}}">
      <text>{{questionCount}} 题</text>
      <text class="meta-sep">·</text>
      <text>{{optionCount}} 选项</text>
    </view>
  </view>

  <!-- 答题卡预览区域 -->
  <scroll-view class="preview-area" scroll-y>
    <image
      class="answer-sheet-img"
      src="{{imgSrc}}"
      mode="widthFix"
      wx:if="{{imgSrc}}"
      show-menu-by-longpress
    />
    <view wx:elif="{{error}}" class="error-wrap">
      <view class="error-icon">!</view>
      <text class="error-text">{{error}}</text>
    </view>
    <view class="loading-wrap" wx:else>
      <view class="loading-spinner"></view>
      <text class="loading-text">正在生成答题卡...</text>
    </view>
  </scroll-view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <button class="bottom-btn btn-save" bindtap="saveImage" disabled="{{!imgSrc}}">
      <view class="btn-icon btn-icon-save"></view>
      <text>保存图片</text>
    </button>
    <view class="btn-divider"></view>
    <button class="bottom-btn btn-export" bindtap="exportPdf" disabled="{{loading && !pdfPath}}">
      <view class="btn-icon btn-icon-pdf"></view>
      <text>导出PDF</text>
    </button>
  </view>
</view>
