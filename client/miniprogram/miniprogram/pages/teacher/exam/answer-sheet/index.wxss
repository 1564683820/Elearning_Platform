/* ===== 答题卡二级页面 ===== */
.page {
  min-height: 100vh;
  background: #F5F1EB;
  display: flex;
  flex-direction: column;
}

/* ===== 顶部信息栏 ===== */
.header {
  background: #FFFFFF;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #EDE8E0;
  flex-shrink: 0;
}
.header-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2D2A26;
  line-height: 1.3;
}
.header-meta {
  font-size: 22rpx;
  color: #8A8682;
  margin-top: 6rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.meta-sep {
  color: #C8C2BA;
}

/* ===== 预览区域 ===== */
.preview-area {
  flex: 1;
  padding: 20rpx 24rpx 30rpx;
  overflow-y: auto;
}
.answer-sheet-img {
  width: 100%;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 20rpx rgba(44,95,45,0.08);
  background: #FFFFFF;
  display: block;
}

/* ===== 加载状态 ===== */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
}
.loading-spinner {
  width: 52rpx;
  height: 52rpx;
  border: 3rpx solid #E8E2DA;
  border-top-color: #2C5F2D;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.loading-text {
  font-size: 24rpx;
  color: #8A8682;
  margin-top: 16rpx;
}

/* ===== 错误状态 ===== */
.error-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 180rpx 40rpx;
}
.error-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #FEF2F2;
  border: 2rpx solid #FCA5A5;
  color: #DC2626;
  font-size: 40rpx;
  font-weight: 800;
  text-align: center;
  line-height: 80rpx;
  margin-bottom: 24rpx;
}
.error-text {
  font-size: 26rpx;
  color: #6B7280;
  text-align: center;
  line-height: 1.6;
}

/* ===== 底部操作栏 ===== */
.bottom-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  background: #FFFFFF;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #EDE8E0;
  gap: 0;
}
.bottom-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 22rpx 0;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  border: none;
  line-height: 1.4;
  min-height: 0;
}
.bottom-btn::after {
  border: none;
}
.bottom-btn:active {
  transform: scale(0.97);
}
.bottom-btn[disabled] {
  opacity: 0.4;
}
.btn-save {
  background: #F0F4EC;
  color: #2C5F2D;
}
.btn-export {
  background: #2C5F2D;
  color: #FFFFFF;
}
.btn-divider {
  width: 16rpx;
  flex-shrink: 0;
}
.btn-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}
