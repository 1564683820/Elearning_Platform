<view class="page">
  <!-- 头部 -->
  <view class="header">
    <view class="header-top">
      <text class="class-name">{{className}}</text>
      <text class="student-count">{{students.length}}名学生</text>
    </view>
    <view class="search-bar">
      <input class="search-input" placeholder="搜索姓名/考号" value="{{searchKey}}" bindinput="onSearchInput" />
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="actions">
    <button class="btn-import" bindtap="goToImport">导入花名册</button>
  </view>

  <!-- 加载中 -->
  <view class="loading-container" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:elif="{{students.length === 0}}">
    <view class="empty-icon-people">
      <view class="people-icon">
        <view class="person-head"></view>
        <view class="person-body"></view>
      </view>
      <view class="people-icon second">
        <view class="person-head"></view>
        <view class="person-body"></view>
      </view>
    </view>
    <text class="empty-text">暂无学生，请导入花名册</text>
    <button class="btn-empty-import" bindtap="goToImport">导入花名册</button>
  </view>

  <!-- 学生列表 -->
  <view class="student-list" wx:else>
    <view
      class="student-item"
      wx:for="{{filteredStudents}}" wx:key="id"
      data-exam-number="{{item.exam_number}}"
      data-student-name="{{item.student_name}}"
      bindtap="goToStudentMistakes"
    >
      <view class="student-avatar">
        <text class="avatar-text">{{item._avatarChar}}</text>
      </view>
      <view class="student-info">
        <text class="student-name">{{item.student_name}}</text>
        <text class="student-exam-no">考号: {{item.exam_number}}</text>
        <text class="student-account" wx:if="{{item._showAccount}}">登录账号: {{item._showAccount}}</text>
      </view>
      <text class="student-arrow">›</text>
    </view>
  </view>
</view>
