.page {
  min-height: 100vh;
  background: #F5F7FA;
}

.header {
  background: #fff;
  padding: 30rpx;
  border-bottom: 1rpx solid #EAEDF0;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.class-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.student-count {
  font-size: 24rpx;
  color: #9CA3AF;
}

.search-bar {
  background: #F3F4F6;
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
}

.search-input {
  font-size: 26rpx;
  width: 100%;
  padding: 8rpx 0;
  line-height: 1.5;
}

.actions {
  padding: 20rpx 30rpx;
}

.btn-import {
  background: #5B9E6F;
  color: #fff;
  font-size: 26rpx;
  padding: 16rpx 32rpx;
  border-radius: 10rpx;
  border: none;
  width: auto;
  display: inline-flex;
}

.loading-container {
  padding: 80rpx 0;
  text-align: center;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #E5E7EB;
  border-top-color: #5B9E6F;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin: 0 auto;
}

@keyframes spin { to { transform: rotate(360deg); } }

.empty-state {
  text-align: center;
  padding: 80rpx 0;
}

.empty-icon-people {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
  height: 80rpx;
}
.people-icon {
  width: 32rpx;
  height: 44rpx;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}
.people-icon.second {
  opacity: 0.5;
  transform: scale(0.85);
}
.person-head {
  width: 14rpx;
  height: 14rpx;
  border: 2rpx solid #9CA3AF;
  border-radius: 50%;
  position: absolute;
  top: 2rpx;
}
.person-body {
  width: 28rpx;
  height: 18rpx;
  border: 2rpx solid #9CA3AF;
  border-radius: 50% 50% 0 0;
  border-bottom: none;
  position: absolute;
  bottom: 0;
}

.empty-text {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 24rpx;
}

.btn-empty-import {
  background: #5B9E6F;
  color: #fff;
  font-size: 26rpx;
  padding: 16rpx 40rpx;
  border-radius: 10rpx;
  border: none;
  display: inline-block;
}

.student-list {
  padding: 0 30rpx;
}

.student-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.student-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: #5B9E6F;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.student-info {
  flex: 1;
}

.student-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: block;
}

.student-exam-no {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 4rpx;
  display: block;
}

.student-account {
  font-size: 20rpx;
  color: #5B9E6F;
  margin-top: 2rpx;
  display: block;
}

.student-arrow {
  font-size: 32rpx;
  color: #9CA3AF;
}
