/* ===== 我的 — 教师作品集杂志风格 ===== */
.page {
  min-height: 100vh;
  background: #F5F1EB;
  padding-bottom: 140rpx;
}

/* ===== 顶部窄条 ===== */
.top-bar {
  padding: 28rpx 24rpx 16rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #EDE8E0;
  margin-bottom: 12rpx;
}
.top-bar-line {
  width: 24rpx;
  height: 3rpx;
  background: #97BC62;
  border-radius: 2rpx;
  margin-bottom: 14rpx;
}
.top-bar-row {
  display: flex;
  align-items: center;
}
.top-bar-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #2D2A26;
  letter-spacing: 1rpx;
}

/* ===== 个人信息卡片 ===== */
.profile-card {
  display: flex;
  gap: 20rpx;
  margin: 0 16rpx;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  border: 1rpx solid #EDE8E0;
  box-shadow: 0 2rpx 8rpx rgba(44,95,45,0.03);
}
.profile-card-left {
  flex-shrink: 0;
}
.profile-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #DDA15E, #C48B4A);
  display: flex;
  align-items: center;
  justify-content: center;
}
.profile-avatar-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
}
.profile-card-right {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.profile-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #2D2A26;
  letter-spacing: 1rpx;
}
.profile-role {
  font-size: 20rpx;
  color: #8A8682;
  margin-top: 2rpx;
}
.profile-stats {
  display: flex;
  align-items: center;
  gap: 0;
  margin-top: 12rpx;
}
.profile-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 14rpx;
}
.profile-stat:first-child {
  padding-left: 0;
}
.profile-stat-divider {
  width: 1rpx;
  height: 24rpx;
  background: #E8E2DA;
}
.profile-stat-num {
  font-size: 24rpx;
  font-weight: 800;
  color: #2C5F2D;
}
.profile-stat-lbl {
  font-size: 16rpx;
  color: #8A8682;
  margin-top: 2rpx;
  letter-spacing: 1rpx;
}

/* ===== 菜单区域 ===== */
.menu-section {
  padding: 28rpx 24rpx 0;
}
.menu-section-label {
  font-size: 18rpx;
  font-weight: 700;
  color: #8A8682;
  letter-spacing: 3rpx;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}
.menu-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(44,95,45,0.04);
  border: 1rpx solid #E8E2DA;
}
.menu-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  border-bottom: 1rpx solid #F0EBE4;
  transition: background 0.15s;
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-item:active {
  background: #F5F1EB;
}

/* CSS 图标 — 人物 */
.menu-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: #F0F4EC;
  position: relative;
}
.icon-person::before {
  content: '';
  position: absolute;
  top: 10rpx;
  width: 16rpx;
  height: 16rpx;
  border: 2rpx solid #2C5F2D;
  border-radius: 50%;
}
.icon-person::after {
  content: '';
  position: absolute;
  bottom: 8rpx;
  width: 24rpx;
  height: 14rpx;
  border: 2rpx solid #2C5F2D;
  border-radius: 50% 50% 0 0;
  border-bottom: none;
}

/* CSS 图标 — 建筑 */
.icon-building {
  background: #F0F4EC;
}
.icon-building::before {
  content: '';
  width: 20rpx;
  height: 24rpx;
  border: 2rpx solid #2C5F2D;
  border-radius: 2rpx 2rpx 0 0;
  position: relative;
}
.icon-building::after {
  content: '';
  position: absolute;
  bottom: 10rpx;
  width: 16rpx;
  height: 2rpx;
  background: #2C5F2D;
  box-shadow: 0 -4rpx 0 #2C5F2D, 0 6rpx 0 #2C5F2D;
  left: 50%;
  margin-left: -8rpx;
}

/* CSS 图标 — 帮助 */
.icon-help {
  background: #F8F3EA;
}
.icon-help::before {
  content: '';
  width: 22rpx;
  height: 22rpx;
  border: 2rpx solid #DDA15E;
  border-radius: 50%;
  position: relative;
}
.icon-help::after {
  content: '?';
  position: absolute;
  font-size: 20rpx;
  font-weight: 800;
  color: #DDA15E;
}

.menu-text-group {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.menu-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #2D2A26;
}
.menu-sub {
  font-size: 20rpx;
  color: #8A8682;
  margin-top: 2rpx;
}
.menu-arrow {
  width: 14rpx;
  height: 14rpx;
  border: 2rpx solid #C8C2BA;
  border-top: none;
  border-left: none;
  transform: rotate(-45deg);
  flex-shrink: 0;
}

/* ===== 退出登录 ===== */
.logout-section {
  padding: 16rpx 24rpx;
}
.logout-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  width: 100%;
  padding: 22rpx;
  border-radius: 14rpx;
  background: #FFFFFF;
  border: 1rpx solid #E8E2DA;
  color: #C0392B;
  font-size: 26rpx;
  font-weight: 600;
}
.logout-btn:active {
  background: #FAF0EE;
}
.icon-logout {
  width: 18rpx;
  height: 18rpx;
  position: relative;
  border: 2rpx solid #C0392B;
  border-right: none;
  border-radius: 2rpx 0 0 2rpx;
}
.icon-logout::after {
  content: '';
  position: absolute;
  top: 2rpx;
  right: -8rpx;
  width: 8rpx;
  height: 8rpx;
  border: 2rpx solid #C0392B;
  border-top: none;
  border-left: none;
  transform: rotate(-45deg);
}
.version {
  display: block;
  text-align: center;
  margin-top: 16rpx;
  font-size: 20rpx;
  color: #C8C2BA;
  letter-spacing: 1rpx;
}

/* ===== 底部弹出式弹窗 ===== */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(45,42,38,0.4);
  z-index: 200;
  display: none;
  align-items: flex-end;
  justify-content: center;
}
.modal-overlay.modal-show {
  display: flex;
}
.modal-sheet {
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  padding: 24rpx 32rpx 40rpx;
  animation: sheetUp 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}
@keyframes sheetUp {
  from { transform: translateY(40rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}
.modal-handle {
  width: 48rpx;
  height: 5rpx;
  border-radius: 3rpx;
  background: #E8E2DA;
  margin: 0 auto 20rpx;
}
.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}
.modal-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2D2A26;
  letter-spacing: 1rpx;
}
.modal-close {
  width: 48rpx;
  height: 48rpx;
  border: none;
  background: #F5F1EB;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}
.close-icon {
  width: 16rpx;
  height: 16rpx;
  position: relative;
}
.close-icon::before,
.close-icon::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 0;
  width: 100%;
  height: 2rpx;
  background: #8A8682;
  border-radius: 1rpx;
}
.close-icon::before { transform: rotate(45deg); }
.close-icon::after { transform: rotate(-45deg); }

/* 表单 */
.modal-body {
  display: flex;
  flex-direction: column;
}
.form-field {
  margin-bottom: 24rpx;
}
.form-label {
  font-size: 22rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
  display: block;
  color: #2D2A26;
  letter-spacing: 1rpx;
}
.form-input {
  width: 100%;
  padding: 24rpx 22rpx;
  border: 1rpx solid #E8E2DA;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #2D2A26;
  background: #FDFCFA;
  box-sizing: border-box;
}
.form-input:focus {
  border-color: #2C5F2D;
  background: #FFFFFF;
}
.modal-btn {
  width: 100%;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #2C5F2D;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  border: none;
  margin-top: 8rpx;
}
.modal-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

/* ===== 加载 ===== */
.loading-container {
  padding: 300rpx 0;
  text-align: center;
}
.loading-spinner {
  width: 52rpx;
  height: 52rpx;
  border: 3rpx solid #E8E2DA;
  border-top-color: #2C5F2D;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin: 0 auto;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
