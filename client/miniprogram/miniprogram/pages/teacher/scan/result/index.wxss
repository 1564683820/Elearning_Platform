.page {
  min-height: 100vh;
  background: #F5F7FA;
  padding-bottom: 40rpx;
}

/* 成绩卡 */
.score-card {
  margin: 20rpx 30rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}
.score-card.success { background: linear-gradient(135deg, #ECFDF5, #D1FAE5); }
.score-card.warning { background: linear-gradient(135deg, #FFFBEB, #FEF3C7); }

.score-top { display: flex; align-items: center; gap: 16rpx; }
.student-avatar { width: 64rpx; height: 64rpx; border-radius: 32rpx; background: #5B9E6F; color: #fff; font-size: 28rpx; text-align: center; line-height: 64rpx; }
.score-info { flex: 1; }
.student-name { font-size: 30rpx; font-weight: 700; color: #1F2937; display: block; }
.score-text { font-size: 36rpx; font-weight: 700; color: #5B9E6F; }
.score-bottom { margin-top: 12rpx; display: flex; align-items: center; gap: 12rpx; }
.multi-label { font-size: 22rpx; color: #6B7280; }
.multi-divider { color: #D1D5DB; }

.pending-hint { margin-top: 10rpx; font-size: 24rpx; color: #F59E0B; font-weight: 600; display: flex; align-items: center; gap: 8rpx; }
.warn-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #F59E0B; flex-shrink: 0; }

/* 统计 */
.summary-bar { display: flex; gap: 12rpx; margin: 0 30rpx 16rpx; }
.summary-item { flex: 1; background: #fff; border-radius: 12rpx; padding: 14rpx 0; text-align: center; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.04); }
.summary-value { display: block; font-size: 32rpx; font-weight: 700; color: #1F2937; }
.summary-value.warn { color: #F59E0B; }
.summary-label { display: block; font-size: 20rpx; color: #9CA3AF; margin-top: 4rpx; }

/* 逐题 */
.answers-section { margin: 0 30rpx; }
.section-title { display: flex; justify-content: space-between; font-size: 26rpx; font-weight: 600; color: #333; margin-bottom: 12rpx; }
.section-count { font-size: 22rpx; color: #9CA3AF; }
.answer-item { background: #fff; border-radius: 14rpx; padding: 20rpx; margin-bottom: 12rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.04); }
.answer-item.correct { border-left: 6rpx solid #5B9E6F; }
.answer-item.wrong { border-left: 6rpx solid #E74C3C; }
.answer-item.warn-bg { border-left-color: #F59E0B; }

.answer-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.answer-left { display: flex; align-items: center; gap: 8rpx; }
.answer-number { font-size: 24rpx; font-weight: 600; color: #333; }
.answer-type { font-size: 20rpx; color: #9CA3AF; }
.answer-type.multi-type { color: #F59E0B; }

.answer-status-tag { padding: 6rpx 14rpx; border-radius: 10rpx; display: flex; align-items: center; justify-content: center; }
.tag-correct { background: #ECFDF5; }
.tag-wrong { background: #FEF2F2; }
.tag-pending { background: #FFFBEB; }

/* CSS 小图标 */
.check-tiny { width: 10rpx; height: 18rpx; border: 3rpx solid #5B9E6F; border-top: none; border-left: none; transform: rotate(45deg); margin-top: -4rpx; }
.cross-tiny { width: 14rpx; height: 14rpx; position: relative; }
.cross-tiny::before, .cross-tiny::after { content: ''; position: absolute; top: 50%; left: 0; width: 100%; height: 2rpx; background: #E74C3C; border-radius: 1rpx; }
.cross-tiny::before { transform: rotate(45deg); }
.cross-tiny::after { transform: rotate(-45deg); }
.warn-tiny { width: 14rpx; height: 14rpx; border: 2rpx solid #F59E0B; border-radius: 50%; position: relative; }
.warn-tiny::before { content: ''; position: absolute; top: 2rpx; left: 6rpx; width: 2rpx; height: 7rpx; background: #F59E0B; }
.warn-tiny::after { content: ''; position: absolute; bottom: 2rpx; left: 6rpx; width: 2rpx; height: 2rpx; background: #F59E0B; }

.answer-row { font-size: 22rpx; display: flex; align-items: center; flex-wrap: wrap; gap: 6rpx; margin-bottom: 4rpx; }
.label { color: #6B7280; }
.value { color: #1F2937; font-weight: 500; }
.correct-text { color: #5B9E6F; font-weight: 600; }
.wrong-text { color: #E74C3C; font-weight: 600; }
.warn-text { color: #F59E0B; font-weight: 600; }
.gray-text { color: #9CA3AF; }
.correct-flag { font-size: 20rpx; color: #5B9E6F; font-weight: 600; background: #ECFDF5; padding: 2rpx 10rpx; border-radius: 6rpx; }
.score-tag { font-size: 20rpx; color: #9CA3AF; }
.hint { font-size: 22rpx; color: #3B82F6; }

/* 确认弹窗 */
.modal-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,.5); display: flex; align-items: center; justify-content: center; z-index: 100; }
.modal-box { background: #fff; border-radius: 20rpx; padding: 32rpx; width: 560rpx; }
.modal-title { font-size: 28rpx; font-weight: 700; color: #1F2937; margin-bottom: 24rpx; text-align: center; }
.modal-options { display: flex; gap: 16rpx; justify-content: center; flex-wrap: wrap; margin-bottom: 28rpx; }
.modal-option { width: 100rpx; height: 100rpx; border: 2rpx solid #D1D5DB; border-radius: 12rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 32rpx; font-weight: 600; color: #333; position: relative; }
.modal-option.selected { border-color: #5B9E6F; background: #ECFDF5; color: #5B9E6F; }
.correct-badge { position: absolute; top: -8rpx; right: -8rpx; background: #ECFDF5; border-radius: 50%; width: 28rpx; height: 28rpx; display: flex; align-items: center; justify-content: center; }
.correct-badge .check-tiny { border-color: #5B9E6F; }
.modal-actions { display: flex; gap: 16rpx; }
.modal-btn { flex: 1; font-size: 26rpx; padding: 18rpx 0; border-radius: 10rpx; border: none; text-align: center; }
.modal-btn.cancel { background: #F3F4F6; color: #666; }
.modal-btn.confirm { background: #5B9E6F; color: #fff; }
.modal-btn.confirm[disabled] { opacity: .5; }
