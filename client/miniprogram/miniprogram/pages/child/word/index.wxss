/* 幼儿识词页面样式 */
page {
  background: #F5F7FA;
}

.child-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F5F7FA;
}

.status-bar {
  height: 88rpx;
}

/* 顶部栏 */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx 8rpx;
  background: #F5F7FA;
}

.logo-area {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.logo-e {
  font-size: 44rpx;
  font-weight: 800;
  color: #5B9E6F;
}

.logo-text {
  font-size: 36rpx;
  font-weight: 800;
  color: #1F2937;
}

.phase-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  border-radius: 99rpx;
  background: #5B9E6F;
}

.phase-btn-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.phase-arrow {
  font-size: 18rpx;
  color: rgba(255,255,255,0.8);
}

/* 滚动区 */
.scroll-area {
  flex: 1;
  padding: 0 32rpx;
  overflow-y: auto;
}

/* 单词卡片 */
.word-card {
  background: #FFFFFF;
  border-radius: 52rpx;
  padding: 48rpx 40rpx;
  text-align: center;
  box-shadow: 0 8rpx 40rpx rgba(0,0,0,0.08);
  margin-top: 24rpx;
  margin-bottom: 24rpx;
  border: 4rpx solid #D1FAE5;
}

.word-image {
  width: 320rpx;
  height: 240rpx;
  background: linear-gradient(135deg, #F0FDF4, #D1FAE5);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 32rpx;
}

.word-letters {
  font-size: 64rpx;
  font-weight: 900;
  color: #5B9E6F;
  letter-spacing: 12rpx;
}

.word-text-wrap {
  margin-bottom: 40rpx;
}

.word-english {
  display: block;
  font-size: 68rpx;
  font-weight: 900;
  color: #1F2937;
  line-height: 1.2;
}

.word-chinese {
  display: block;
  font-size: 48rpx;
  color: #6B7280;
  margin-top: 8rpx;
  font-weight: 500;
}

/* 底部按钮 */
.word-actions {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  margin-bottom: 32rpx;
}

.speak-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 40rpx;
  border-radius: 99rpx;
  background: linear-gradient(135deg, #5B9E6F, #7AB88A);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 24rpx rgba(91,158,111,0.3);
}

.speak-btn.speaking {
  animation: speakPulse 0.5s infinite;
}

@keyframes speakPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

.speak-btn::after {
  border: none;
}

.speak-icon {
  font-size: 36rpx;
}

.speak-label {
  font-size: 28rpx;
}

.next-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #9CA3AF;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
}

.next-btn::after {
  border: none;
}

.next-icon {
  font-size: 40rpx;
  line-height: 1;
}

/* 轮播指示点 */
.dots-row {
  display: flex;
  justify-content: center;
  gap: 12rpx;
}

.dot-item {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #D1D5DB;
  transition: all 0.2s;
}

.dot-item.active {
  width: 44rpx;
  border-radius: 8rpx;
  background: #5B9E6F;
}

/* 语音气泡 */
.bubbles-area {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.bubble {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  animation: fadeInUp 0.3s ease;
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.bubble-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F0FDF4;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 32rpx;
}

.bubble-text {
  max-width: 70%;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: #F0FDF4;
  font-size: 24rpx;
  color: #1F2937;
  line-height: 1.6;
  border-top-left-radius: 4rpx;
}

/* 底部安全 */
.bottom-safe {
  height: 160rpx;
}
