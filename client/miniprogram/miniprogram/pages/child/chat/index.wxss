/* 幼儿小e对话页面样式 */
page {
  background: #F5F7FA;
}

.child-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: linear-gradient(180deg, #F0FDF4 0%, #F5F7FA 30%);
}

.status-bar {
  height: 88rpx;
}

/* 顶部栏 */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx 8rpx;
}

.logo-area {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.logo-e {
  font-size: 44rpx;
  font-weight: 800;
  color: #5B9E6F;
}

.logo-text {
  font-size: 36rpx;
  font-weight: 800;
  color: #1F2937;
}

.phase-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  border-radius: 99rpx;
  background: #5B9E6F;
}

.phase-btn-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.phase-arrow {
  font-size: 18rpx;
  color: rgba(255,255,255,0.8);
}

/* 对话区域 */
.chat-area {
  flex: 1;
  overflow-y: auto;
  padding: 0 32rpx;
  padding-bottom: 200rpx;
}

.messages-wrap {
  padding: 24rpx 0;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.message-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.message-row.user-row {
  justify-content: flex-end;
}

.message-row.ai-row {
  justify-content: flex-start;
}

.msg-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 28rpx;
  background: #F0FDF4;
}

.msg-user-avatar {
  background: #E8F5E9;
}

.msg-body {
  max-width: 70%;
  padding: 20rpx 28rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  line-height: 1.8;
}

.msg-ai {
  background: #FFFFFF;
  color: #1F2937;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  border-top-left-radius: 4rpx;
  word-break: break-all;
}

.msg-user {
  background: linear-gradient(135deg, #5B9E6F, #7AB88A);
  color: #FFFFFF;
  border-top-right-radius: 4rpx;
}

.msg-text {
  display: block;
  white-space: pre-line;
}

.listen-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  background: #F0FDF4;
  font-size: 22rpx;
  color: #5B9E6F;
  border: none;
}

.listen-btn::after {
  border: none;
}

/* 录音区域 */
.record-area {
  position: fixed;
  bottom: 120rpx;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0;
  background: transparent;
}

.record-btn {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #5B9E6F, #7AB88A);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(91,158,111,0.35);
  transition: transform 0.2s;
}

.record-btn.recording {
  transform: scale(0.9);
  background: #3D7A51;
  animation: recordPulse 0.8s infinite;
}

@keyframes recordPulse {
  0%, 100% { box-shadow: 0 8rpx 32rpx rgba(91,158,111,0.35); }
  50% { box-shadow: 0 8rpx 48rpx rgba(91,158,111,0.6); }
}

.record-btn::after {
  border: none;
}

.record-icon {
  font-size: 48rpx;
}

.record-hint {
  font-size: 22rpx;
  color: #6B7280;
}
