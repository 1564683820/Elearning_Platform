/* 幼儿启蒙首页样式 */
page {
  background: #F5F7FA;
}

.child-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F5F7FA;
}

/* 状态栏占位 */
.status-bar {
  height: 88rpx;
}

/* 顶部栏 */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx 8rpx;
  background: #F5F7FA;
}

.logo-area {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.logo-e {
  font-size: 44rpx;
  font-weight: 800;
  color: #5B9E6F;
}

.logo-text {
  font-size: 36rpx;
  font-weight: 800;
  color: #1F2937;
}

.phase-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  border-radius: 99rpx;
  background: #5B9E6F;
}

.phase-btn-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.phase-arrow {
  font-size: 18rpx;
  color: rgba(255,255,255,0.8);
}

/* 滚动内容 */
.scroll-area {
  flex: 1;
  padding: 0 32rpx;
  overflow-y: auto;
}

/* 欢迎区域 */
.welcome-section {
  text-align: center;
  padding: 32rpx 0 24rpx;
}

.welcome-title {
  font-size: 48rpx;
  font-weight: 900;
  color: #5B9E6F;
  line-height: 1.3;
}

.welcome-subtitle {
  font-size: 26rpx;
  color: #9CA3AF;
  margin-top: 8rpx;
}

.decor-dots {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
}

.d1 { background: #5B9E6F; }
.d2 { background: #7AB88A; }
.d3 { background: #D1FAE5; }

/* 播放器卡片 */
.player-card {
  background: #F0FDF4;
  border-radius: 36rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  border: 4rpx solid #D1FAE5;
}

.player-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.player-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #5B9E6F, #7AB88A);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 36rpx;
}

.player-info {
  flex: 1;
}

.player-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2937;
}

.player-subtitle {
  display: block;
  font-size: 22rpx;
  color: #6B7280;
  margin-top: 4rpx;
}

.player-progress {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.progress-track {
  flex: 1;
  height: 10rpx;
  background: #D1FAE5;
  border-radius: 5rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #5B9E6F, #7AB88A);
  border-radius: 5rpx;
  transition: width 0.3s;
}

.progress-fill.playing {
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.7; }
}

.progress-time {
  font-size: 20rpx;
  color: #6B7280;
  white-space: nowrap;
}

/* 部分标题 */
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2937;
  margin-bottom: 16rpx;
}

/* 儿歌列表 */
.song-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.song-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  background: #F0FDF4;
  border-radius: 28rpx;
  border: 2rpx solid #D1FAE5;
}

.song-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #5B9E6F, #7AB88A);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 28rpx;
}

.song-info {
  flex: 1;
}

.song-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1F2937;
}

.song-subtitle {
  display: block;
  font-size: 20rpx;
  color: #6B7280;
  margin-top: 4rpx;
}

.song-duration {
  font-size: 20rpx;
  color: #9CA3AF;
}

/* 底部安全 */
.bottom-safe {
  height: 160rpx;
}

/* 弹窗覆盖层 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s;
}

.modal-overlay.show {
  opacity: 1;
  pointer-events: auto;
}

/* 保存提示弹窗 */
.tip-box {
  width: 500rpx;
  background: #FFFFFF;
  border-radius: 40rpx;
  padding: 48rpx 40rpx;
  text-align: center;
}

.tip-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.tip-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1F2937;
  margin-bottom: 12rpx;
}

.tip-desc {
  font-size: 26rpx;
  color: #6B7280;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.tip-highlight {
  color: #5B9E6F;
  font-weight: 700;
}

.tip-btn {
  width: 100%;
  padding: 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #5B9E6F, #7AB88A);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 24rpx rgba(91,158,111,0.3);
}

.tip-btn::after {
  border: none;
}
