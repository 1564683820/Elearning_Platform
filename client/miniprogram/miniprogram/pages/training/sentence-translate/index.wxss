/* 句子翻译训练 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
}

/* Header */
.custom-header {
  background: #FFFFFF;
  border-bottom: 1rpx solid var(--border);
}

.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 14rpx;
}

.header-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: var(--border-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.header-btn-icon {
  font-size: 32rpx;
  color: var(--text-primary);
}

.header-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  flex: 1;
  text-align: center;
}

.progress-section {
  padding: 24rpx 40rpx 16rpx;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.progress-label {
  font-size: 26rpx;
  color: var(--text-muted);
  font-weight: 600;
}

.score-row {
  display: flex;
  gap: 20rpx;
}

.score-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.score-icon-circle {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.score-icon-circle.correct-circle {
  background: var(--success-bg);
}

.score-icon-circle.wrong-circle {
  background: var(--danger-bg);
}

.score-icon-inner {
  font-size: 20rpx;
  font-weight: 700;
}

.correct-circle .score-icon-inner {
  color: var(--success);
}

.wrong-circle .score-icon-inner {
  color: var(--danger);
}

.score-correct { font-size: 26rpx; color: var(--success); font-weight: 600; }
.score-wrong { font-size: 26rpx; color: var(--danger); font-weight: 600; }

/* 翻译方向 */
.direction-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.direction-btn {
  flex: 1;
  padding: 20rpx 0;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F3F4F6;
}

.direction-btn.active {
  background: var(--primary-bg);
}

.direction-text {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-muted);
}

.direction-text.active {
  color: var(--primary);
}

.direction-switch {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: var(--shadow-md);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.direction-switch-icon {
  font-size: 32rpx;
  color: var(--primary);
}

/* 题目 */
.question-card {
  margin-bottom: 24rpx;
}

.question-tag-row {
  margin-bottom: 12rpx;
}

.question-text {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.6;
  display: block;
  margin: 12rpx 0;
}

.keyword-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
  flex-wrap: wrap;
}

.keyword-hint {
  font-size: 22rpx;
  color: var(--text-muted);
}

.keyword-tag {
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 600;
}

/* 输入区 */
.input-section {
  margin-bottom: 24rpx;
}

.input-label-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.input-label {
  font-size: 24rpx;
  color: var(--text-muted);
  font-weight: 600;
}

.input-count {
  font-size: 22rpx;
  color: var(--text-light);
}

.translate-input {
  width: 100%;
  min-height: 200rpx;
  padding: 24rpx;
  background: transparent;
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.7;
  margin-bottom: 20rpx;
}

/* 提交按钮 */
.submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #5B9E6F 0%, #7AB88A 100%);
  color: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(91,158,111,0.3);
}

.submit-btn-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.submit-btn-icon {
  font-size: 30rpx;
  color: #FFFFFF;
  font-weight: 700;
}

/* 参考答案 */
.analysis-card {
  border-left: 8rpx solid var(--primary);
}

.analysis-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.analysis-icon {
  font-size: 28rpx;
}

.analysis-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary);
}

.reference-answer {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.7;
  margin-bottom: 20rpx;
  display: block;
}

.key-points {
  background: var(--border-lighter);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.points-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
  display: block;
}

.point-item {
  display: flex;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.point-dot {
  color: var(--primary);
  font-size: 28rpx;
}

.point-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.7;
}

.alternative-section {
  margin-bottom: 24rpx;
}

.alt-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-muted);
  margin-bottom: 8rpx;
  display: block;
}

.alt-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.7;
}

/* 下一题按钮 */
.next-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #5B9E6F 0%, #7AB88A 100%);
  color: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(91,158,111,0.3);
}

.next-btn-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.next-btn-arrow {
  font-size: 30rpx;
  color: #FFFFFF;
  font-weight: 700;
}
