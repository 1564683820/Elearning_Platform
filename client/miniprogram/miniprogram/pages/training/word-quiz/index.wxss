  line-height: 1.3;
}

.drawer-subtitle {
  font-size: 22rpx;
  color: #9CA3AF;
  display: block;
  margin-top: 4rpx;
}

/* ===== 设置区域 ===== */
.setting-section {
  padding: 0 36rpx;
