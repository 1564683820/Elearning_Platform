}

.article-trans-text {
  font-size: 26rpx;
  color: #6B7280;
  line-height: 1.7;
  display: block;
}

/* ================================================================ */
/*  翻译 / 作文：评分结果卡片                                         */
/* ================================================================ */
.score-card {
  margin: 0 32rpx 28rpx;
  padding: 40rpx 36rpx;
  background: #FFFFFF;
  border-radius: var(--radius-lg);
  box-shadow: 0 6rpx 28rpx rgba(0,0,0,0.06);
  box-sizing: border-box;
  animation: scoreCardIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

@keyframes scoreCardIn {
  0% { opacity: 0; transform: translateY(20rpx) scale(0.95); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}

/* 总分大圆 */
.score-big-circle {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0 auto 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.1);
}

.score-big-circle.excellent {
  background: linear-gradient(135deg, #10B981, #34D399);
  box-shadow: 0 8rpx 32rpx rgba(16,185,129,0.3);
}

.score-big-circle.good {
  background: linear-gradient(135deg, #F59E0B, #FBBF24);
  box-shadow: 0 8rpx 32rpx rgba(245,158,11,0.3);
}

.score-big-circle.poor {
  background: linear-gradient(135deg, #EF4444, #F87171);
  box-shadow: 0 8rpx 32rpx rgba(239,68,68,0.3);
}

.score-big-value {
  font-size: 52rpx;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1.1;
}

.score-big-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.85);
  font-weight: 600;
}

/* 维度评分 */
.dimension-scores {
  margin-bottom: 28rpx;
  padding: 24rpx;
  background: #F9FAFB;
  border-radius: 20rpx;
}

.dimension-item {
  margin-bottom: 16rpx;
}

.dimension-item:last-child {
  margin-bottom: 0;
}

.dimension-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.dimension-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #374151;
}

.dimension-value {
  font-size: 24rpx;
  font-weight: 700;
  color: #5B9E6F;
}

.dimension-bar {
