  box-shadow: inset 0 0 0 2rpx rgba(91,158,111,0.3);
}



/* ===== 开始训练按钮 ===== */
.setting-start-btn {
  margin: 20rpx 36rpx 0;
  padding: 30rpx 36rpx;
  background: linear-gradient(135deg, #5B9E6F 0%, #7AB88A 100%);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 8rpx 32rpx rgba(91,158,111,0.35);
