  line-height: 1.7;
  flex: 1;
}

/* 操作按钮 */
.score-actions {
  display: flex;
  gap: 16rpx;
  margin: 0 32rpx 32rpx;
}

.score-action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 26rpx 0;
  border-radius: 28rpx;
  font-size: 28rpx;
  font-weight: 700;
  transition: all 0.2s ease;
}

.score-action-btn:active {
  transform: scale(0.97);
}

.retry-btn {
  background: #F3F4F6;
  color: #374151;
  border: 2rpx solid #E5E7EB;
}

.retry-btn:active {
  background: #E5E7EB;
}

.next-btn-inline {
  background: linear-gradient(135deg, #5B9E6F 0%, #7AB88A 100%);
  color: #FFFFFF;
  box-shadow: 0 6rpx 20rpx rgba(91,158,111,0.3);
}

.next-btn-inline:active {
  box-shadow: 0 3rpx 10rpx rgba(91,158,111,0.2);
}

.action-btn-text {
  font-size: 28rpx;
  font-weight: 700;
}

.action-btn-arrow {
  font-size: 32rpx;
  font-weight: 300;
}

/* ================================================================ */
/*  作文：编辑区                                                      */
/* ================================================================ */
.essay-input-section {
  margin: 0 32rpx 24rpx;
  padding: 32rpx;
  background: #FFFFFF;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  box-sizing: border-box;
}

.essay-textarea {
  width: 100%;
  min-height: 360rpx;
  padding: 24rpx;
  background: #F9FAFB;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.8;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

/* ================================================================ */
/*  作文：要点区                                                      */
/* ================================================================ */
.key-points-section {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #F0F4FF;
  border-radius: 16rpx;
  border-left: 6rpx solid #6366F1;
}

.key-points-title {
  font-size: 22rpx;
  font-weight: 700;
  color: #6366F1;
  display: block;
  margin-bottom: 14rpx;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.key-point {
  display: flex;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.key-point:last-child {
  margin-bottom: 0;
}

.kp-dot {
  font-size: 24rpx;
  color: #6366F1;
  flex-shrink: 0;
  line-height: 1.5;
}

.kp-text {
  font-size: 26rpx;
  color: #374151;
  line-height: 1.6;
  flex: 1;
}

/* ================================================================ */
/*  收藏按钮                                                          */
/* ================================================================ */
.progress-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.fav-btn {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #F3F4F6;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.fav-btn:active {
  transform: scale(0.88);
}

.fav-icon {
  font-size: 28rpx;
  color: #D1D5DB;
  transition: all 0.2s ease;
  line-height: 1;
}

.fav-icon.active {
  color: #F59E0B;
  text-shadow: 0 2rpx 8rpx rgba(245,158,11,0.3);
}
