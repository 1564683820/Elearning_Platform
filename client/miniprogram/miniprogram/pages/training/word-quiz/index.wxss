}

.score-feedback-icon {
  font-size: 32rpx;
  flex-shrink: 0;
  line-height: 1.4;
}

.score-feedback-text {
  font-size: 26rpx;
  color: #065F46;
  line-height: 1.7;
  flex: 1;
}

/* 参考译文 / 范文 */
.score-reference {
  padding: 24rpx;
  background: #F9FAFB;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  border-left: 6rpx solid #5B9E6F;
}

.score-ref-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #5B9E6F;
  display: block;
  margin-bottom: 10rpx;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.score-ref-text {
  font-size: 26rpx;
  color: #374151;
  line-height: 1.8;
  display: block;
}

