/* ===== 设置抽屉（全新设计） ===== */
.drawer-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 200;
  backdrop-filter: blur(4rpx);
}

.settings-drawer {
  position: fixed;
  top: 0;
  right: -620rpx;
  bottom: 0;
  width: 620rpx;
  background: linear-gradient(180deg, #FAFBFC 0%, #F0F2F5 100%);
  z-index: 201;
  transition: right 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  padding: 0 0 40rpx 0;
  box-sizing: border-box;
  overflow-y: auto;
  box-shadow: -12rpx 0 60rpx rgba(0,0,0,0.12);
  border-radius: 48rpx 0 0 48rpx;
}

.settings-drawer.open { right: 0; }

/* 顶部发光装饰 */
.drawer-glow {
  position: sticky;
  top: 0;
  width: 100%;
  height: 6rpx;
  background: linear-gradient(90deg, #5B9E6F, #7AB88A, #A3D4B0, #7AB88A, #5B9E6F);
  background-size: 200% 100%;
  animation: glowMove 3s ease infinite;
  z-index: 1;
  flex-shrink: 0;
}

@keyframes glowMove {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

.drawer-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 52rpx 36rpx 36rpx;
  background: #FFFFFF;
  margin: 0 0 24rpx 0;
}

.drawer-back-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: #F3F4F6;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: background 0.2s;
}

.drawer-back-btn:active {
  background: #E5E7EB;
}

.drawer-back-icon {
  font-size: 32rpx;
  color: #374151;
  font-weight: 700;
}

.drawer-header-text {
  flex: 1;
}

.drawer-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1F2937;
