/* ================================================================ */
.article-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.article-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2937;
  flex: 1;
  line-height: 1.4;
}

.article-word-count {
  font-size: 22rpx;
  color: #9CA3AF;
  background: #F3F4F6;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.article-content {
  font-size: 28rpx;
  color: #374151;
  line-height: 1.9;
  display: block;
}

.article-translation {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #F9FAFB;
