/* 训练 - 5合1 侧边栏切换 */
/* 加载占位 */
.loading-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  padding: 120rpx 32rpx;
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-muted);
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
}

/* 可滚动内容区 */
.content-scroll {
  flex: 1;
  min-height: 0;
}

.scroll-bottom-spacer {
  height: 40rpx;
}

/* 自定义Header */
.custom-header {
  background: #FFFFFF;
  border-bottom: 1rpx solid var(--border);
}

.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 14rpx;
}

.header-menu-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.menu-line {
  width: 36rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--text-primary);
}

.header-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  flex: 1;
  text-align: center;
}

.header-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: var(--border-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.header-btn-icon {
  font-size: 32rpx;
  color: var(--text-primary);
}

/* ===== 侧边栏（全新设计） ===== */
.sidebar-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 200;
  backdrop-filter: blur(4rpx);
}

.sidebar {
  position: fixed;
  top: 0;
  left: -520rpx;
  bottom: 0;
  width: 520rpx;
  background: #FFFFFF;
  z-index: 201;
  transition: left 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  box-shadow: 8rpx 0 60rpx rgba(0, 0, 0, 0.12);
  display: flex;
  flex-direction: column;
  border-radius: 0 40rpx 40rpx 0;
  overflow: hidden;
}

.sidebar.open {
  left: 0;
}

.sidebar-bg-pattern {
  position: absolute;
  top: -120rpx;
  right: -80rpx;
  width: 320rpx;
  height: 320rpx;
  background: radial-gradient(circle, rgba(91,158,111,0.06) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

.sidebar-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 52rpx 32rpx 36rpx;
  border-bottom: 2rpx solid #F3F4F6;
  position: relative;
}

.sidebar-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #5B9E6F, #7AB88A);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 6rpx 20rpx rgba(91,158,111,0.25);
}

.sidebar-avatar-icon {
  font-size: 36rpx;
}

.sidebar-header-info {
  flex: 1;
}

.sidebar-header-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2937;
  display: block;
  line-height: 1.3;
}

.sidebar-header-subtitle {
  font-size: 22rpx;
  color: #9CA3AF;
  display: block;
  margin-top: 4rpx;
}

.sidebar-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F3F4F6;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: background 0.2s;
}

.sidebar-close:active {
  background: #E5E7EB;
}

.sidebar-close-icon {
  font-size: 24rpx;
  color: #6B7280;
  font-weight: 700;
}

.sidebar-menu {
  flex: 1;
  padding: 12rpx 16rpx;
  overflow-y: auto;
}

.sidebar-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 20rpx;
  margin: 4rpx 0;
  border-radius: 20rpx;
  transition: all 0.25s ease;
  position: relative;
}

.sidebar-item:active {
  transform: scale(0.97);
}

.sidebar-item.active {
  background: linear-gradient(135deg, rgba(91,158,111,0.08), rgba(91,158,111,0.04));
}

/* 左侧激活指示条 */
.sidebar-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 20%;
  bottom: 20%;
  width: 6rpx;
  border-radius: 0 6rpx 6rpx 0;
  background: linear-gradient(180deg, #5B9E6F, #7AB88A);
}

.sidebar-item-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}

.sidebar-item-icon {
  font-size: 30rpx;
}

.sidebar-item-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.sidebar-item-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #374151;
  line-height: 1.4;
}

.sidebar-item.active .sidebar-item-text {
  color: #5B9E6F;
  font-weight: 700;
}

.sidebar-item-desc {
  font-size: 20rpx;
  color: #9CA3AF;
  line-height: 1.3;
}

.sidebar-item.active .sidebar-item-desc {
  color: rgba(91,158,111,0.6);
}

.sidebar-item-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #5B9E6F;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  opacity: 0;
  transform: scale(0.5);
  transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  box-shadow: 0 4rpx 12rpx rgba(91,158,111,0.3);
}

.sidebar-item-check.show {
  opacity: 1;
  transform: scale(1);
}

.check-icon {
  font-size: 20rpx;
  color: #FFFFFF;
  font-weight: 700;
}

/* ===== 公共进度区 ===== */
.progress-section {
  padding: 24rpx 32rpx 16rpx;
  background: var(--bg);
  box-sizing: border-box;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.progress-label {
  font-size: 26rpx;
  color: var(--text-muted);
  font-weight: 600;
}

.score-row {
  display: flex;
  gap: 20rpx;
}

.score-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.score-icon-circle {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.correct-circle { background: var(--success-bg); }
.wrong-circle { background: var(--danger-bg); }

.score-icon-inner {
  font-size: 20rpx;
  font-weight: 700;
}

.correct-circle .score-icon-inner { color: var(--success); }
.wrong-circle .score-icon-inner { color: var(--danger); }

.score-correct {
  font-size: 26rpx;
  color: var(--success);
  font-weight: 600;
}

.score-wrong {
  font-size: 26rpx;
  color: var(--danger);
  font-weight: 600;
}

.timer {
  font-size: 22rpx;
  color: var(--text-muted);
  font-weight: 600;
}

/* ===== 题目卡片（重新设计） ===== */
.question-card {
  position: relative;
  margin: 0 32rpx 28rpx;
  padding: 40rpx 36rpx 36rpx;
  background: #FFFFFF;
  border-radius: var(--radius-lg);
  box-shadow: 0 6rpx 28rpx rgba(0,0,0,0.05);
  box-sizing: border-box;
  overflow: hidden;
}

.question-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #5B9E6F, #7AB88A, #A3D4B0);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
}

.question-badge-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.question-badge {
  padding: 6rpx 18rpx;
  background: rgba(91,158,111,0.10);
  color: #5B9E6F;
  font-size: 22rpx;
  font-weight: 700;
  border-radius: 8rpx;
}

.question-number {
  font-size: 22rpx;
  color: var(--text-muted);
  font-weight: 600;
}

.question-type, .question-tags, .question-tag-row {
  margin-bottom: 20rpx;
}

.question-tags {
  display: flex;
  gap: 12rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.02em;
}

.tag-primary {
  background: rgba(91,158,111,0.10);
  color: #5B9E6F;
}

.tag-warning {
  background: rgba(249,115,22,0.10);
  color: #F97316;
}

.tag-gray {
  background: var(--border-light);
  color: var(--text-muted);
}

.question-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #1F2937;
  line-height: 1.6;
  display: block;
  letter-spacing: 0.01em;
}

.question-hint {
  font-size: 24rpx;
  color: var(--text-muted);
  display: block;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #F9FAFB;
  border-radius: 16rpx;
  line-height: 1.5;
}

/* ===== 选项（重新设计） ===== */
.options-list {
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  box-sizing: border-box;
}

.quiz-option {
  position: relative;
  display: flex;
  align-items: center;
  padding: 32rpx 36rpx;
  background: #FFFFFF;
  border-radius: var(--radius-lg);
  border: 3rpx solid #EAEDF0;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  box-sizing: border-box;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03);
  overflow: hidden;
}

.quiz-option:active {
  transform: scale(0.98);
  box-shadow: 0 1rpx 6rpx rgba(0,0,0,0.05);
}

/* 左侧装饰线 - 默认隐藏 */
.quiz-option::before {
  content: '';
  position: absolute;
  left: 0;
  top: 20%;
  bottom: 20%;
  width: 5rpx;
  border-radius: 0 4rpx 4rpx 0;
  background: transparent;
  transition: all 0.25s ease;
}

/* 选中状态 */
.quiz-option.selected {
  border-color: #5B9E6F;
  background: rgba(91,158,111,0.04);
  box-shadow: 0 4rpx 20rpx rgba(91,158,111,0.12);
}

.quiz-option.selected::before {
  background: #5B9E6F;
  top: 18%;
  bottom: 18%;
}

/* 正确状态 */
.quiz-option.correct {
  border-color: #10B981;
  background: #F0FDF4;
  box-shadow: 0 4rpx 20rpx rgba(16,185,129,0.15);
}

.quiz-option.correct::before {
  background: #10B981;
  top: 12%;
  bottom: 12%;
}

/* 错误状态 */
.quiz-option.wrong {
  border-color: #EF4444;
  background: #FEF2F2;
  box-shadow: 0 4rpx 20rpx rgba(239,68,68,0.12);
}

.quiz-option.wrong::before {
  background: #EF4444;
  top: 12%;
  bottom: 12%;
}

.option-content {
  display: flex;
  align-items: center;
  flex: 1;
}

.option-letter {
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  background: #F3F4F6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 800;
  color: #9CA3AF;
  flex-shrink: 0;
  transition: all 0.25s ease;
}

.quiz-option.selected .option-letter {
  background: #5B9E6F;
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(91,158,111,0.3);
}

.quiz-option.correct .option-letter {
  background: #10B981;
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(16,185,129,0.3);
}

.quiz-option.wrong .option-letter {
  background: #EF4444;
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(239,68,68,0.3);
}

.option-text {
  flex: 1;
  font-size: 30rpx;
  color: #1F2937;
  margin-left: 28rpx;
  line-height: 1.6;
  font-weight: 500;
}

.quiz-option.correct .option-text {
  color: #065F46;
}

.quiz-option.wrong .option-text {
  color: #991B1B;
}

/* 正确/错误图标 */
.option-status {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 16rpx;
  animation: statusPop 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.status-icon {
  font-size: 24rpx;
  font-weight: 800;
}

.correct-icon {
  background: #10B981;
  color: #FFFFFF;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(16,185,129,0.35);
}

.wrong-icon {
  background: #EF4444;
  color: #FFFFFF;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(239,68,68,0.35);
}

@keyframes statusPop {
  0% { transform: scale(0); }
  60% { transform: scale(1.25); }
  100% { transform: scale(1); }
}

/* ===== 解析区（重新设计） ===== */
.analysis-card {
  margin: 28rpx 32rpx 32rpx;
  padding: 36rpx 32rpx;
  background: #FFFFFF;
  border-radius: var(--radius-lg);
  border-left: 8rpx solid #5B9E6F;
  box-shadow: 0 6rpx 24rpx rgba(0,0,0,0.05);
  box-sizing: border-box;
}

.analysis-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #F3F4F6;
}

.analysis-star {
  font-size: 36rpx;
  color: #5B9E6F;
  flex-shrink: 0;
}

.analysis-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #5B9E6F;
}

.analysis-body {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.analysis-meaning {
  font-size: 28rpx;
  color: #1F2937;
  line-height: 1.7;
  font-weight: 500;
  padding: 20rpx 24rpx;
  background: #F9FAFB;
  border-radius: 16rpx;
}

.analysis-example, .analysis-tip {
  position: relative;
  border-radius: 16rpx;
  padding: 24rpx 24rpx 24rpx 36rpx;
  background: #F9FAFB;
}

.analysis-example::before {
  content: '';
  position: absolute;
  left: 16rpx;
  top: 24rpx;
  width: 8rpx;
  bottom: 24rpx;
  border-radius: 4rpx;
}

.analysis-example::before {
  background: #5B9E6F;
}

.analysis-tip::before {
  content: '';
  position: absolute;
  left: 16rpx;
  top: 24rpx;
  width: 8rpx;
  bottom: 24rpx;
  border-radius: 4rpx;
  background: #F97316;
}

.example-label, .tip-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #5B9E6F;
  display: block;
  margin-bottom: 10rpx;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.tip-label {
  color: #F97316;
}

.example-text, .tip-text {
  font-size: 26rpx;
  color: #6B7280;
  line-height: 1.7;
}

.analysis-rule {
  font-size: 28rpx;
  color: #1F2937;
  line-height: 1.7;
  font-weight: 500;
  padding: 20rpx 24rpx;
  background: #F9FAFB;
  border-radius: 16rpx;
}

.analysis-example-block, .analysis-similar {
  border-radius: 16rpx;
  padding: 24rpx 24rpx 24rpx 36rpx;
  background: #F9FAFB;
  position: relative;
}

.analysis-example-block::before {
  content: '';
  position: absolute;
  left: 16rpx;
  top: 24rpx;
  width: 8rpx;
  bottom: 24rpx;
  border-radius: 4rpx;
  background: #5B9E6F;
}

.analysis-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #5B9E6F;
  display: block;
  margin-bottom: 10rpx;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.analysis-text {
  font-size: 26rpx;
  color: #6B7280;
  line-height: 1.7;
}

.similar-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.similar-tag {
  padding: 10rpx 22rpx;
  border-radius: 16rpx;
  background: rgba(91,158,111,0.10);
  color: #5B9E6F;
  font-size: 24rpx;
  font-weight: 600;
}

.analysis-answer {
  font-size: 28rpx;
  font-weight: 700;
  color: #10B981;
  margin-bottom: 12rpx;
  display: block;
  padding: 16rpx 24rpx;
  background: #F0FDF4;
  border-radius: 16rpx;
}

.analysis-explain {
  font-size: 26rpx;
  color: #6B7280;
  line-height: 1.7;
  margin-bottom: 28rpx;
  display: block;
  padding: 16rpx 24rpx;
  background: #F9FAFB;
  border-radius: 16rpx;
}

/* ===== 底部导航栏 ===== */
.bottom-bar {
  flex-shrink: 0;
  padding: 16rpx 32rpx 32rpx;
  background: #FFFFFF;
  border-top: 2rpx solid var(--border-light);
  box-shadow: 0 -4rpx 24rpx rgba(0,0,0,0.04);
}

.bottom-bar-inner {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.bottom-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 26rpx 0;
  border-radius: 28rpx;
  font-size: 30rpx;
  font-weight: 700;
  transition: all 0.2s ease;
}

.bottom-btn:active {
  transform: scale(0.97);
}

.prev-btn {
  background: var(--border-light);
  color: var(--text-primary);
  border: 2rpx solid var(--border);
}

.prev-btn:active {
  background: #E5E7EB;
}

.prev-btn.disabled {
  opacity: 0.4;
  pointer-events: none;
}

.next-btn {
  background: linear-gradient(135deg, #5B9E6F 0%, #7AB88A 100%);
  color: #FFFFFF;
  box-shadow: 0 6rpx 20rpx rgba(91,158,111,0.3);
}

.next-btn:active {
  box-shadow: 0 3rpx 10rpx rgba(91,158,111,0.2);
}

.bottom-divider {
  width: 2rpx;
  height: 40rpx;
  background: var(--border-light);
  flex-shrink: 0;
}

.btn-icon {
  font-size: 36rpx;
  font-weight: 300;
  line-height: 1;
}

.btn-text {
  font-size: 28rpx;
  font-weight: 700;
}

/* ===== 句子翻译特有 ===== */
.direction-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.direction-btn {
  flex: 1;
  padding: 20rpx 0;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F3F4F6;
}

.direction-btn.active { background: var(--primary-bg); }

.direction-text {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-muted);
}

.direction-text.active { color: var(--primary); }

.direction-switch {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: var(--shadow-md);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.direction-switch-icon {
  font-size: 32rpx;
  color: var(--primary);
}

.keyword-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
  flex-wrap: wrap;
}

.keyword-hint {
  font-size: 22rpx;
  color: var(--text-muted);
}

.keyword-tag {
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.input-section {
  margin: 0 32rpx 24rpx;
  padding: 32rpx;
  background: #FFFFFF;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  box-sizing: border-box;
}

.input-label-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

