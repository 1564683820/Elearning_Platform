  display: flex;
  gap: 10rpx;
  margin-bottom: 10rpx;
  padding: 16rpx 20rpx;
  background: #FFFBEB;
  border-radius: 16rpx;
  border: 2rpx solid rgba(245,158,11,0.15);
}

