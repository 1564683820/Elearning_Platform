/* 阅读训练 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
}

/* Header */
.custom-header {
  background: #FFFFFF;
  border-bottom: 1rpx solid var(--border);
}

.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16rpx;
}

.header-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: var(--border-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.header-btn-icon {
  font-size: 32rpx;
  color: var(--text-primary);
}

.header-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  flex: 1;
  text-align: center;
}

/* 进度区 */
.progress-section {
  padding: 24rpx 40rpx 16rpx;
  background: var(--bg);
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.progress-label {
  font-size: 24rpx;
  color: var(--text-muted);
  font-weight: 600;
}

.timer {
  font-size: 22rpx;
  color: var(--text-muted);
  font-weight: 600;
}

/* 文章区 */
.article-scroll {
  max-height: 440rpx;
  margin: 0 32rpx 16rpx;
}

.article-card {
  padding: 32rpx;
  background: #FFFFFF;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.article-source {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.source-icon {
  font-size: 24rpx;
}

.source-text {
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 600;
}

.article-body {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.article-paragraph {
  font-size: 26rpx;
  color: var(--text-primary);
  line-height: 1.8;
}

/* 题目区 */
.question-section {
  margin: 0 32rpx 24rpx;
}

.question-card-inline {
  background: #FFFFFF;
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-md);
}

.question-text {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.6;
  display: block;
  margin-bottom: 20rpx;
}

.options-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.quiz-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  background: #FFFFFF;
  border-radius: var(--radius-lg);
  border: 4rpx solid #E5E7EB;
  transition: all 0.3s;
}

.quiz-option.correct {
  border-color: var(--success);
  background: var(--success-bg);
}

.quiz-option.wrong {
  border-color: var(--danger);
  background: var(--danger-bg);
}

.option-content {
  display: flex;
  align-items: center;
  flex: 1;
}

.option-letter {
  width: 56rpx;
  height: 56rpx;
  border-radius: 20rpx;
  background: var(--border-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-muted);
  flex-shrink: 0;
}

.option-letter.correct {
  background: var(--success);
  color: #FFFFFF;
}

.option-letter.wrong {
  background: var(--danger);
  color: #FFFFFF;
}

.option-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
  margin-left: 24rpx;
}

/* 解析 */
.analysis-card {
  margin: 24rpx 32rpx;
  padding: 32rpx;
  background: #FFFFFF;
  border-radius: var(--radius-lg);
  border-left: 8rpx solid var(--primary);
  box-shadow: var(--shadow-sm);
}

.analysis-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.analysis-icon {
  font-size: 28rpx;
}

.analysis-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary);
}

.analysis-answer {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--success);
  margin-bottom: 8rpx;
  display: block;
}

.analysis-explain {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.7;
  margin-bottom: 24rpx;
  display: block;
}

/* 下一题按钮 */
.next-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #5B9E6F 0%, #7AB88A 100%);
  color: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(91,158,111,0.3);
}

.next-btn-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.next-btn-arrow {
  font-size: 30rpx;
  color: #FFFFFF;
  font-weight: 700;
}
