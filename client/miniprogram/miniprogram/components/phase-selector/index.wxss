/* 阶段选择弹窗样式 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s;
}
.modal-overlay.show {
  opacity: 1;
  pointer-events: auto;
}

.modal-box {
  width: 580rpx;
  max-height: 80vh;
  background: #FFFFFF;
  border-radius: 40rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 40rpx 120rpx rgba(0,0,0,0.2);
  overflow-y: auto;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1F2937;
  text-align: center;
}

.modal-desc {
  font-size: 24rpx;
  color: #6B7280;
  text-align: center;
  margin: 8rpx 0 28rpx;
}

/* 阶段列表 */
.phase-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.phase-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 24rpx;
  border-radius: 24rpx;
  border: 3rpx solid #EAEDF0;
  cursor: pointer;
  transition: all 0.2s;
}

.phase-item.selected {
  border-color: #5B9E6F;
  background: #F0FDF4;
}

.phase-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 700;
}

.phase-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.phase-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1F2937;
}

.phase-desc {
  font-size: 22rpx;
  color: #6B7280;
}

.phase-check {
  flex-shrink: 0;
}

.check-circle {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid #D1D5DB;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #FFFFFF;
  transition: all 0.2s;
}

.check-circle.checked {
  background: #5B9E6F;
  border-color: #5B9E6F;
}

/* 按钮行 */
.modal-actions {
  display: flex;
  gap: 16rpx;
}

.btn-cancel,
.btn-save {
  flex: 1;
  padding: 24rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 700;
  border: none;
  text-align: center;
  line-height: 1;
}

.btn-cancel {
  background: #F3F4F6;
  color: #6B7280;
}

.btn-save {
  background: linear-gradient(135deg, #5B9E6F 0%, #7AB88A 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(91,158,111,0.3);
}

.btn-cancel::after,
.btn-save::after {
  border: none;
}
