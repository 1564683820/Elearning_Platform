/* 底部导航栏样式 */
.footer-tabs {
  display: flex;
  background: #FFFFFF;
  border-top: 1rpx solid #EAEDF0;
  height: 112rpx;
  padding-bottom: env(safe-area-inset-bottom);
  flex-shrink: 0;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  font-size: 20rpx;
  color: #9CA3AF;
  position: relative;
  transition: color 0.2s;
}

.tab-item.active {
  color: #5B9E6F;
}

.tab-icon {
  font-size: 40rpx;
  line-height: 1;
}

.tab-text {
  font-size: 20rpx;
  font-weight: 500;
}

.tab-indicator {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: #5B9E6F;
  border-radius: 0 0 4rpx 4rpx;
}
