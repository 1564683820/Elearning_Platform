/* 自定义底部导航栏 - 绿色系原型风格 */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: #FFFFFF;
  border-top: 2rpx solid #DDE6DE;
  height: 120rpx;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 1000;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 8rpx 0;
  position: relative;
  color: #9C9CAB;
  font-size: 20rpx;
  font-weight: 500;
  transition: color 0.3s;
}

.tab-item.active {
  color: #5B9E6F;
}

/* 激活顶部指示条 */
.tab-item.active::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 32rpx;
  height: 4rpx;
  background: #5B9E6F;
  border-radius: 0 0 4rpx 4rpx;
}

/* Tab 图标容器 */
.tab-icon {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

/* 班级图标（双人/用户组） */
.icon-class {
  width: 32rpx;
  height: 24rpx;
  border: 3rpx solid currentColor;
  border-radius: 4rpx;
  position: relative;
}
.icon-class::after {
  content: '';
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  width: 16rpx;
  height: 12rpx;
  border: 3rpx solid currentColor;
  border-radius: 3rpx;
  background: #FFFFFF;
}

/* 批卷图标（相机） */
.icon-exam {
  width: 30rpx;
  height: 24rpx;
  border: 3rpx solid currentColor;
  border-radius: 5rpx;
  position: relative;
}
.icon-exam::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 12rpx;
  height: 12rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
}
.icon-exam::before {
  content: '';
  position: absolute;
  top: -7rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 12rpx;
  height: 6rpx;
  border: 3rpx solid currentColor;
  border-bottom: none;
  border-radius: 4rpx 4rpx 0 0;
  background: #FFFFFF;
}

/* 我的图标（人物） */
.icon-user {
  width: 16rpx;
  height: 16rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  position: relative;
}
.icon-user::after {
  content: '';
  position: absolute;
  top: 20rpx;
  left: -8rpx;
  width: 28rpx;
  height: 20rpx;
  border: 3rpx solid currentColor;
  border-radius: 0 0 14rpx 14rpx;
  border-top: none;
}

/* Tab 文字 */
.tab-text {
  font-size: 20rpx;
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

/* 激活指示器（无文本时使用伪元素） */
.tab-indicator {
  display: none;
}
