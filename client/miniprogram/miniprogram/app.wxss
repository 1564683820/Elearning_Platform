/* ==================== 全局样式 ==================== */
page {
  --primary: #5B9E6F;
  --primary-light: #7AB88A;
  --primary-bg: rgba(91,158,111,0.10);
  --primary-bg-strong: rgba(91,158,111,0.18);
  --gradient: linear-gradient(135deg, #5B9E6F 0%, #7AB88A 100%);
  --bg: #F5F7FA;
  --card: #FFFFFF;
  --text-primary: #1F2937;
  --text-secondary: #6B7280;
  --text-muted: #9CA3AF;
  --text-light: #D1D5DB;
  --border: #EAEDF0;
  --border-light: #F3F4F6;
  --border-lighter: #F9FAFB;
  --success: #10B981;
  --success-bg: #F0FDF4;
  --warning: #F97316;
  --warning-bg: #FFF7ED;
  --danger: #EF4444;
  --danger-bg: #FEF2F2;
  --shadow-sm: 0 2rpx 12rpx rgba(0,0,0,0.06);
  --shadow-md: 0 4rpx 24rpx rgba(0,0,0,0.08);
  --radius-sm: 16rpx;
  --radius-md: 24rpx;
  --radius-lg: 32rpx;
  --radius-xl: 40rpx;

  background: var(--bg);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

/* 通用容器 */
.container {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 24rpx;
  min-height: 100vh;
  background: var(--bg);
}

/* 卡片通用 */
.card {
  background: var(--card);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-sm);
  margin-bottom: 24rpx;
}

/* 渐变主色按钮 */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #5B9E6F 0%, #7AB88A 100%);
  color: #FFFFFF;
  border-radius: var(--radius-md);
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(91,158,111,0.3);
}

.btn-primary::after {
  border: none;
}

/* 胶囊标签 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.tag-primary {
  background: #EEF2FF;
  color: var(--primary);
}

.tag-warning {
  background: var(--warning-bg);
  color: var(--warning);
}

.tag-gray {
  background: var(--border-light);
  color: var(--text-muted);
}

.tag-success {
  background: var(--success-bg);
  color: var(--success);
}

/* 选项按钮 */
.option-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  background: var(--border-light);
  color: var(--text-secondary);
  border: none;
}

.option-btn.active {
  background: var(--primary);
  color: #FFFFFF;
}

/* 进度条 */
.progress-bar {
  width: 100%;
  height: 12rpx;
  background: var(--border-light);
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #5B9E6F, #7AB88A);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

/* 头部通用 */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
}

.page-header-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.header-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-md);
  background: var(--border-light);
  border: none;
  padding: 0;
}

.header-btn::after {
  border: none;
}

/* 列表项 */
.list-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  background: var(--card);
  border-bottom: 1rpx solid var(--border-light);
}

.list-item:last-child {
  border-bottom: none;
}

/* 开关组件 */
.switch {
  width: 88rpx;
  height: 52rpx;
  border-radius: 26rpx;
  background: var(--text-light);
  position: relative;
  transition: background 0.3s;
}

.switch.on {
  background: var(--primary);
}

.switch-circle {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #FFFFFF;
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  transition: left 0.3s;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
}

.switch.on .switch-circle {
  left: 40rpx;
}

/* 清除按钮默认样式 */
button {
  background: initial;
  line-height: normal;
}

button::after {
  border: none;
}

/* 安全区域底部 */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* 文字省略 */
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ==================== UI原型通用组件补充 ==================== */

/* icon-box - 圆角方形图标容器 */
.icon-box {
  width: 56rpx;
  height: 56rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.icon-box.primary {
  background: var(--primary-bg);
}

.icon-box.warning {
  background: var(--warning-bg);
}

.icon-box.success {
  background: var(--success-bg);
}

.icon-box.muted {
  background: var(--border-light);
}

/* list-group - 列表组 */
.list-group {
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.list-group-title {
  padding: 20rpx 32rpx 4rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--border-lighter);
  background: var(--card);
}

.list-item:last-child {
  border-bottom: none;
}

.list-item-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.list-item-label {
  font-size: 28rpx;
  color: var(--text-primary);
}

.list-item-value {
  font-size: 24rpx;
  color: var(--text-muted);
}

.list-item-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.list-item-arrow {
  font-size: 28rpx;
  color: var(--text-light);
}

/* tabs-row - 底部下划线Tab */
.tabs-underline {
  display: flex;
  border-bottom: 1rpx solid var(--border);
  background: var(--card);
}

.tab-underline-item {
  flex: 1;
  padding: 24rpx 0;
  text-align: center;
  font-size: 26rpx;
  font-weight: 400;
  color: var(--text-muted);
  border-bottom: 4rpx solid transparent;
  transition: all 0.2s;
}

.tab-underline-item.active {
  font-weight: 700;
  color: var(--primary);
  border-bottom-color: var(--primary);
}

/* quiz-option - 答题选项 */
.quiz-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-radius: 32rpx;
  border: 4rpx solid #E5E7EB;
  background: var(--card);
  transition: all 0.2s;
}

.quiz-option.selected {
  border-color: var(--primary);
  background: var(--primary-bg);
}

.quiz-option.correct {
  border-color: var(--success);
  background: var(--success-bg);
}

.quiz-option.wrong {
  border-color: var(--danger);
  background: var(--danger-bg);
}

.option-letter {
  width: 56rpx;
  height: 56rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  flex-shrink: 0;
  background: var(--border-light);
  color: var(--text-muted);
}

.quiz-option.selected .option-letter {
  background: var(--primary);
  color: #FFFFFF;
}

.quiz-option.correct .option-letter {
  background: var(--success);
  color: #FFFFFF;
}

.quiz-option.wrong .option-letter {
  background: var(--danger);
  color: #FFFFFF;
}

.option-text {
  font-size: 28rpx;
  color: var(--text-primary);
  margin-left: 24rpx;
  flex: 1;
}

/* chat-bubble - 对话气泡 */
.chat-bubble {
  max-width: 70%;
  border-radius: 32rpx;
  padding: 24rpx 28rpx;
  font-size: 26rpx;
  line-height: 1.7;
  word-break: break-all;
}

.chat-bubble.ai {
  background: var(--card);
  box-shadow: var(--shadow-sm);
  color: var(--text-primary);
  border-top-left-radius: 8rpx;
}

.chat-bubble.user {
  background: var(--gradient);
  color: #FFFFFF;
  border-top-right-radius: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(91,158,111,0.3);
}

/* checkbox - 复选框 */
.checkbox-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-lighter);
}

.checkbox-item:last-child {
  border-bottom: none;
}

.checkbox-box {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  border: 3rpx solid var(--text-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.2s;
}

.checkbox-box.checked {
  background: var(--primary);
  border-color: var(--primary);
}

.checkbox-check {
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 700;
}

.checkbox-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.checkbox-desc {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}

/* sidebar - 侧边栏 */
.sidebar-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 200;
  transition: opacity 0.25s;
}

.sidebar {
  position: fixed;
  top: 0;
  left: -440rpx;
  bottom: 0;
  width: 440rpx;
  background: var(--card);
  z-index: 201;
  transition: left 0.35s cubic-bezier(0.4, 0, 0.2, 1);
}

.sidebar.open {
  left: 0;
}

.sidebar-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 16rpx;
}

.sidebar-logo {
  width: 64rpx;
  height: 64rpx;
  border-radius: 24rpx;
  background: var(--gradient);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sidebar-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.sidebar-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  margin: 0 16rpx 8rpx;
  transition: all 0.2s;
}

.sidebar-item.active {
  background: var(--primary-bg);
  color: var(--primary);
  font-weight: 700;
}

.sidebar-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--primary);
  margin-left: auto;
  display: none;
}

.sidebar-item.active .sidebar-dot {
  display: block;
}

/* settings-drawer - 设置抽屉 */
.settings-drawer {
  position: fixed;
  top: 0;
  right: -560rpx;
  bottom: 0;
  width: 560rpx;
  background: var(--card);
  z-index: 201;
  transition: right 0.3s ease;
  padding: 48rpx 32rpx;
  box-sizing: border-box;
  overflow-y: auto;
  box-shadow: -8rpx 0 40rpx rgba(0,0,0,0.1);
}

.settings-drawer.open {
  right: 0;
}

.drawer-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 40rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.drawer-close {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: var(--border-light);
  display: flex;
  align-items: center;
  justify-content: center;
}

.drawer-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

/* analysis-card - 答案解析卡片 */
.analysis-card {
  margin: 24rpx 0;
  padding: 32rpx;
  background: var(--card);
  border-radius: var(--radius-lg);
  border-left: 8rpx solid var(--primary);
  box-shadow: var(--shadow-sm);
}

.analysis-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.analysis-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary);
}

/* next-btn - 下一题按钮 */
.next-btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: var(--gradient);
  color: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 24rpx rgba(91,158,111,0.3);
  margin-top: 24rpx;
}

/* direction-row - 翻译方向切换 */
.direction-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.direction-label {
  flex: 1;
  padding: 20rpx 0;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-muted);
  background: #F3F4F6;
  transition: all 0.3s;
}

.direction-label.active {
  color: var(--primary);
  background: var(--primary-bg);
}

.direction-switch {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: var(--shadow-md);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.direction-switch-icon {
  font-size: 32rpx;
  color: var(--primary);
}
